---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Ecosoft"
  description="The page you're looking for doesn't exist."
>

  <section style="min-height: 60vh; display:flex; align-items:center; justify-content:center; text-align:center; padding:4rem 1rem;">
    <div class="container">
      <div style="font-size:6rem; margin-bottom:1rem;">🔍</div>
      <h1 style="font-size:clamp(2rem, 5vw, 3.5rem); margin-bottom:1rem;">Page not found</h1>
      <p style="font-size:1.125rem; color:var(--text-muted); max-width:480px; margin:0 auto 2.5rem;">
        The page you're looking for has moved, been renamed, or doesn't exist.
        Here are some places to start instead:
      </p>
      <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; margin-bottom:3rem;">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/solutions/erp-odoo" class="btn btn-outline">Odoo ERP</a>
        <a href="/solutions/erp-erpnext" class="btn btn-outline">ERPNext</a>
        <a href="/case-studies" class="btn btn-outline">Case Studies</a>
        <a href="/contact" class="btn btn-outline">Contact</a>
      </div>
      <div style="border-top:1px solid var(--border); padding-top:2rem;">
        <p style="font-size:0.875rem; color:var(--text-muted);">
          If you followed a link that should have worked, please
          <a href="/contact" style="color:var(--accent);">let us know</a>.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>
