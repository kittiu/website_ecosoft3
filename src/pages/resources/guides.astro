---
import BaseLayout from "@layouts/BaseLayout.astro";

const guides = [
  {
    title: "ERP Readiness Assessment Guide",
    description: "วิธีประเมินว่าธุรกิจของคุณพร้อมสำหรับ ERP หรือยัง — และสิ่งที่ต้องปรับปรุงก่อนเริ่มการวางระบบ ครอบคลุมความสมบูรณ์ของกระบวนการ คุณภาพของข้อมูล และการจัดการการเปลี่ยนแปลง",
    category: "การวางแผน",
    icon: "📋",
    gated: true,
  },
  {
    title: "The Odoo CE vs Odoo Enterprise Decision Framework",
    description: "คู่มือที่เป็นระบบสำหรับประเมินว่าคุณจำเป็นต้องใช้ Odoo Enterprise จริงหรือไม่ หรือว่า OCA modules ครอบคลุมความต้องการของคุณแล้ว พร้อมแม่แบบการวิเคราะห์ช่องว่างรายโมดูล",
    category: "Odoo",
    icon: "🟠",
    gated: true,
  },
  {
    title: "ERPNext Implementation Checklist",
    description: "รายการตรวจสอบก่อน Go-Live สำหรับการวางระบบ ERPNext อย่างครบถ้วน — ครอบคลุมการตั้งค่าระบบ การย้ายข้อมูล การทดสอบการยอมรับของผู้ใช้ และการวางแผนการเปลี่ยนผ่าน",
    category: "ERPNext",
    icon: "🔵",
    gated: true,
  },
  {
    title: "Thai Accounting Compliance in Odoo",
    description: "วิธีจัดการ VAT ภาษีหัก ณ ที่จ่าย การรายงานต่อกรมสรรพากร และผังบัญชีไทยใน Odoo CE ด้วย OCA modules พร้อมคู่มืออ้างอิงการตั้งค่า",
    category: "บัญชี",
    icon: "💰",
    gated: true,
  },
  {
    title: "Manufacturing ERP Scope Guide",
    description: "สิ่งที่ควรรวมและไม่ควรรวมใน Scope ของ ERP สำหรับโรงงานผลิต ครอบคลุมความซับซ้อนของ BOM การติดตามการผลิต การควบคุมคุณภาพ และปัญหา Scope Creep ที่พบบ่อยที่สุด",
    category: "การผลิต",
    icon: "🏭",
    gated: true,
  },
  {
    title: "Open Source ERP TCO Calculator",
    description: "แบบจำลองสเปรดชีตสำหรับเปรียบเทียบต้นทุนรวมในการเป็นเจ้าของระหว่าง Open Source ERP (Odoo CE, ERPNext) กับทางเลือกเชิงพาณิชย์ (SAP Business One, Oracle NetSuite)",
    category: "การวางแผน",
    icon: "📊",
    gated: true,
  },
];
---

<BaseLayout
  title="คู่มือและทรัพยากร ERP | Ecosoft"
  description="คู่มือเชิงปฏิบัติสำหรับการวางแผน ERP การวางระบบ Odoo และ ERPNext การปฏิบัติตามกฎระเบียบบัญชีไทย และการกำหนดขอบเขต ERP สำหรับโรงงานผลิต"
>


  <!-- HERO -->
  <section class="hero" style="padding-bottom:2rem;">
    <div class="container">
      <p class="eyebrow">ทรัพยากร</p>
      <h1>Practical guides for ERP decision-makers</h1>
      <p class="hero-lead">
        คู่มือโดยละเอียดสำหรับธุรกิจที่กำลังประเมิน วางแผน หรือนำ Open Source ERP ไปใช้งาน
        เขียนโดยที่ปรึกษาที่มีประสบการณ์ตรงจากการวางระบบจริง — ไม่ใช่ทีมการตลาด
      </p>
    </div>
  </section>

  <!-- GUIDES GRID -->
  <section class="section">
    <div class="container">
      <div class="guides-grid">
        {guides.map((guide) => (
          <div class="guide-card">
            <div class="guide-card-icon">{guide.icon}</div>
            <div class="guide-card-body">
              <span class="tag" style="margin-bottom:0.75rem; display:inline-block;">{guide.category}</span>
              <h3 style="margin-top:0.5rem;">{guide.title}</h3>
              <p>{guide.description}</p>
              <div style="margin-top:1.25rem;">
                {guide.gated ? (
                  <a href="/contact" class="btn btn-outline">ขอรับคู่มือ →</a>
                ) : (
                  <a href="#" class="btn btn-primary">ดาวน์โหลดฟรี →</a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container">
      <h2>กำลังมองหาเนื้อหาเฉพาะด้านอยู่ใช่ไหม?</h2>
      <p>หากมีหัวข้อคู่มือที่คุณต้องการแต่ยังไม่มีในรายการนี้ บอกเราได้เลย — เราเขียนตามความต้องการที่แท้จริงของลูกค้า</p>
      <a href="/contact" class="btn btn-primary">แจ้งหัวข้อคู่มือที่ต้องการ</a>
    </div>
  </section>

</BaseLayout>
