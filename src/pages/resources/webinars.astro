---
import BaseLayout from "@layouts/BaseLayout.astro";

const upcoming = [
  {
    title: "Is ERPNext Right for Your Manufacturing Business?",
    date: "2026-04-10",
    time: "2:00 PM — 3:00 PM ICT",
    format: "Webinar (Zoom)",
    description: "เซสชันเชิงปฏิบัติที่ครอบคลุมวิธีที่ ERPNext จัดการ BOM, การจัดตารางการผลิต, การติดตาม Lot และการคิดต้นทุนงาน — พร้อมการสาธิตระบบสดและ Q&A",
    registerUrl: "/contact",
  },
  {
    title: "Open Source ERP for Thai Government Agencies",
    date: "2026-04-24",
    time: "10:00 AM — 11:00 AM ICT",
    format: "Webinar (Zoom)",
    description: "วิธีการทำงานของ Government ERP Modules ของ Ecosoft — การควบคุมงบประมาณ การจัดซื้อจัดจ้างภาครัฐ และการบัญชีหลายกองทุน พร้อมกรณีศึกษาการนำไปใช้ที่ สวทช.",
    registerUrl: "/contact",
  },
  {
    title: "Odoo CE vs ERPNext — Which Platform Fits Your Business?",
    date: "2026-05-08",
    time: "2:00 PM — 3:00 PM ICT",
    format: "Webinar (Zoom)",
    description: "เซสชันการเปรียบเทียบอย่างตรงไปตรงมา — เราพาเดินทางผ่านทั้งสองแพลตฟอร์มแบบเคียงคู่กัน ครอบคลุมเกณฑ์การตัดสินใจสำคัญสำหรับ SME ไทย ไม่มีการขาย",
    registerUrl: "/contact",
  },
];

const past = [
  {
    title: "From Spreadsheets to ERP — When Is the Right Time?",
    description: "คู่มือเชิงปฏิบัติสำหรับการประเมินความพร้อม ERP — ครอบคลุมสัญญาณที่บ่งชี้ว่าธุรกิจของคุณเติบโตเกินกว่าที่สเปรดชีตรองรับได้ และสิ่งที่ต้องทำก่อนเริ่มการติดตั้ง",
  },
  {
    title: "Thai Accounting Compliance in Odoo",
    description: "วิธีจัดการ VAT ภาษีหัก ณ ที่จ่าย ผังบัญชีไทย และการรายงานต่อกรมสรรพากรใน Odoo Community Edition ด้วย OCA modules",
  },
  {
    title: "Manufacturing ERP Deep Dive — BOM, Work Orders, and MRP",
    description: "การอธิบายเชิงเทคนิคเกี่ยวกับฟังก์ชัน ERP สำหรับการผลิต — โครงสร้าง BOM การจัดการ Work Order การวางแผน MRP และการคิดต้นทุนการผลิตใน Odoo",
  },
  {
    title: "ERPNext for Project-Based Businesses",
    description: "วิธีการทำงานของการจัดการโครงการ การออกใบแจ้งหนี้จาก Timesheet การจัดสรรทรัพยากร และการติดตามความสามารถในการทำกำไรของโครงการใน ERPNext — พร้อมกรณีศึกษา EOS Orbit",
  },
];

function formatDate(ds: string) {
  return new Date(ds).toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });
}
---

<BaseLayout
  title="Webinar และกิจกรรม | Ecosoft"
  description="Webinar ฟรีเกี่ยวกับ Odoo, ERPNext, การปฏิบัติตามกฎระเบียบบัญชีไทย ERP สำหรับการผลิต และ ERP ภาครัฐ จากที่ปรึกษาของ Ecosoft"
>


  <!-- HERO -->
  <section class="hero" style="padding-bottom:2rem;">
    <div class="container">
      <p class="eyebrow">ทรัพยากร</p>
      <h1>Free ERP webinars from practitioners</h1>
      <p class="hero-lead">
        เซสชันสดและบันทึกเกี่ยวกับ Odoo, ERPNext, การปฏิบัติตามกฎระเบียบบัญชีไทย ERP สำหรับการผลิต และระบบภาครัฐ —
        ดำเนินการโดยที่ปรึกษาที่ติดตั้งระบบเหล่านี้ในงานประจำวัน
      </p>
    </div>
  </section>

  <!-- UPCOMING -->
  <section class="section">
    <div class="container">
      <h2>Webinar ที่กำลังจะมาถึง</h2>
      <div class="webinars-grid" style="margin-top:2rem;">
        {upcoming.map((w) => (
          <div class="webinar-card">
            <div class="webinar-card-meta">
              <span class="tag">กำลังจะมาถึง</span>
              <span style="font-size:0.875rem; color:var(--text-muted);">{w.format}</span>
            </div>
            <h3>{w.title}</h3>
            <div style="font-size:0.875rem; color:var(--accent); font-weight:600; margin-bottom:0.75rem;">
              {formatDate(w.date)} · {w.time}
            </div>
            <p>{w.description}</p>
            <a href={w.registerUrl} class="btn btn-primary" style="margin-top:1rem;">ลงทะเบียน →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PAST -->
  <section class="section" style="background: var(--surface);">
    <div class="container">
      <h2>Webinar ที่ผ่านมา — ขอรับการบันทึกได้ตามต้องการ</h2>
      <div class="cards-grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap:1.25rem; margin-top:2rem;">
        {past.map((w) => (
          <div class="info-card" style="padding:1.5rem;">
            <span class="tag" style="background:var(--surface);color:var(--text-muted); margin-bottom:0.75rem; display:inline-block;">บันทึกแล้ว</span>
            <h4 style="margin-top:0.5rem;">{w.title}</h4>
            <p style="font-size:0.875rem; color:var(--text-muted);">{w.description}</p>
            <a href="/contact" style="font-size:0.875rem; color:var(--accent); font-weight:600; display:block; margin-top:1rem;">ขอรับการบันทึก →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container">
      <h2>ต้องการเซสชันส่วนตัวสำหรับทีมของคุณหรือไม่?</h2>
      <p>เราจัด Demo และ Briefing แบบส่วนตัวสำหรับบริษัทที่กำลังประเมิน ERP — ครอบคลุมอุตสาหกรรมและความต้องการเฉพาะของคุณ ไม่ใช่เนื้อหาทั่วไป</p>
      <a href="/book-demo" class="btn btn-primary">นัด Demo แบบส่วนตัว</a>
    </div>
  </section>

</BaseLayout>
