---
import BaseLayout from "@layouts/BaseLayout.astro";

const upcoming = [
  {
    title: "Is ERPNext Right for Your Manufacturing Business?",
    date: "2026-04-10",
    time: "2:00 PM — 3:00 PM ICT",
    format: "Webinar (Zoom)",
    description: "A practical session covering how ERPNext handles BOM management, production scheduling, lot tracking, and job costing — with a live system demo and Q&A.",
    registerUrl: "/contact",
  },
  {
    title: "Open Source ERP for Thai Government Agencies",
    date: "2026-04-24",
    time: "10:00 AM — 11:00 AM ICT",
    format: "Webinar (Zoom)",
    description: "How Ecosoft's government ERP modules work — budget encumbrance, government procurement, multi-fund accounting. Includes the NSTDA implementation case study.",
    registerUrl: "/contact",
  },
  {
    title: "Odoo CE vs ERPNext — Which Platform Fits Your Business?",
    date: "2026-05-08",
    time: "2:00 PM — 3:00 PM ICT",
    format: "Webinar (Zoom)",
    description: "An honest comparison session — we walk through both platforms side by side, covering the key decision criteria for Thai SMEs. No sales pitch.",
    registerUrl: "/contact",
  },
];

const past = [
  {
    title: "From Spreadsheets to ERP — When Is the Right Time?",
    description: "A practical guide to assessing ERP readiness — covering the signals that your business has outgrown spreadsheets, and what to do before starting an implementation.",
  },
  {
    title: "Thai Accounting Compliance in Odoo",
    description: "How VAT, withholding tax, Thai chart of accounts, and Revenue Department reporting are handled in Odoo Community Edition with OCA modules.",
  },
  {
    title: "Manufacturing ERP Deep Dive — BOM, Work Orders, and MRP",
    description: "A technical walkthrough of manufacturing ERP functionality — BOM structures, work order management, MRP planning, and production costing in Odoo.",
  },
  {
    title: "ERPNext for Project-Based Businesses",
    description: "How project management, timesheet billing, resource allocation, and project profitability tracking work in ERPNext — with the EOS Orbit case study.",
  },
];

function formatDate(ds: string) {
  return new Date(ds).toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });
}
---

<BaseLayout
  title="Webinars & Events | Ecosoft"
  description="Free webinars on Odoo, ERPNext, Thai accounting compliance, manufacturing ERP, and government ERP from Ecosoft's consultants."
>


  <!-- HERO -->
  <section class="hero" style="padding-bottom:2rem;">
    <div class="container">
      <p class="eyebrow">Resources</p>
      <h1>Free ERP webinars from practitioners</h1>
      <p class="hero-lead">
        Live and recorded sessions on Odoo, ERPNext, Thai accounting compliance, manufacturing ERP, and government systems —
        run by consultants who implement these systems daily.
      </p>
    </div>
  </section>

  <!-- UPCOMING -->
  <section class="section">
    <div class="container">
      <h2>Upcoming webinars</h2>
      <div class="webinars-grid" style="margin-top:2rem;">
        {upcoming.map((w) => (
          <div class="webinar-card">
            <div class="webinar-card-meta">
              <span class="tag">Upcoming</span>
              <span style="font-size:0.875rem; color:var(--text-muted);">{w.format}</span>
            </div>
            <h3>{w.title}</h3>
            <div style="font-size:0.875rem; color:var(--accent); font-weight:600; margin-bottom:0.75rem;">
              {formatDate(w.date)} · {w.time}
            </div>
            <p>{w.description}</p>
            <a href={w.registerUrl} class="btn btn-primary" style="margin-top:1rem;">Register →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PAST -->
  <section class="section" style="background: var(--surface);">
    <div class="container">
      <h2>Past webinars — recordings available on request</h2>
      <div class="cards-grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap:1.25rem; margin-top:2rem;">
        {past.map((w) => (
          <div class="info-card" style="padding:1.5rem;">
            <span class="tag" style="background:var(--surface);color:var(--text-muted); margin-bottom:0.75rem; display:inline-block;">Recorded</span>
            <h4 style="margin-top:0.5rem;">{w.title}</h4>
            <p style="font-size:0.875rem; color:var(--text-muted);">{w.description}</p>
            <a href="/contact" style="font-size:0.875rem; color:var(--accent); font-weight:600; display:block; margin-top:1rem;">Request recording →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container">
      <h2>Want a private session for your team?</h2>
      <p>We run private demos and briefings for companies evaluating ERP — covering your specific industry and requirements, not generic content.</p>
      <a href="/book-demo" class="btn btn-primary">Book a Private Demo</a>
    </div>
  </section>

</BaseLayout>
