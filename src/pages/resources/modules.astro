---
import BaseLayout from "@layouts/BaseLayout.astro";

const modules = [
  {
    name: "Thai Accounting Localisation",
    platform: "Odoo",
    description: "VAT, withholding tax, Thai chart of accounts, revenue department reporting. OCA-maintained with Ecosoft contributions.",
    category: "Accounting",
    oca: true,
  },
  {
    name: "Budget Encumbrance Control",
    platform: "Odoo",
    description: "Government-standard budget encumbrance, real-time budget monitoring, hard over-spend prevention at PO creation.",
    category: "Government",
    oca: false,
  },
  {
    name: "Government Procurement",
    platform: "Odoo",
    description: "Thai government procurement regulation compliance — quotation thresholds, committee approvals, contract registration.",
    category: "Government",
    oca: false,
  },
  {
    name: "Multi-fund Accounting",
    platform: "Odoo",
    description: "Budget and expense tracking by programme, project, and fund simultaneously. Government-standard financial reporting.",
    category: "Government",
    oca: false,
  },
  {
    name: "Manufacturing Extended",
    platform: "Odoo",
    description: "Enhanced manufacturing workflows — custom BOM generation, specification capture, work centre management, production costing.",
    category: "Manufacturing",
    oca: true,
  },
  {
    name: "Landed Cost Extended",
    platform: "Odoo",
    description: "Advanced landed cost allocation for importers — split by weight, volume, or value across multiple purchase orders.",
    category: "Inventory",
    oca: true,
  },
  {
    name: "Thai Accounting Localisation",
    platform: "ERPNext",
    description: "VAT, withholding tax, Thai chart of accounts and tax reports for ERPNext — covering standard Thai Revenue Department requirements.",
    category: "Accounting",
    oca: false,
  },
  {
    name: "Specification-to-BOM",
    platform: "Odoo",
    description: "Custom module for made-to-order manufacturers — generates production BOMs automatically from sales order specifications.",
    category: "Manufacturing",
    oca: false,
  },
  {
    name: "Asset Management Extended",
    platform: "Odoo",
    description: "Government-standard asset register, physical asset verification workflow, disposal and transfer documentation.",
    category: "Government",
    oca: true,
  },
  {
    name: "HR Payroll Thailand",
    platform: "Odoo",
    description: "Thai payroll — social security, personal income tax, provident fund, and Revenue Department payroll reporting.",
    category: "HR",
    oca: true,
  },
  {
    name: "Quality Control Extended",
    platform: "ERPNext",
    description: "Enhanced quality inspection workflows — checkpoint configuration, non-conformance management, corrective action tracking.",
    category: "Manufacturing",
    oca: false,
  },
  {
    name: "Project Billing",
    platform: "ERPNext",
    description: "Milestone-based billing, retainer management, and timesheet-to-invoice automation for project-based businesses.",
    category: "Professional Services",
    oca: false,
  },
];

const categories = [...new Set(modules.map(m => m.category))];
---

<BaseLayout
  title="Open Source ERP Modules | Ecosoft"
  description="Odoo and ERPNext modules built and maintained by Ecosoft — including OCA contributions for Thai accounting, government compliance, manufacturing, and HR."
>


  <!-- HERO -->
  <section class="hero" style="padding-bottom:2rem;">
    <div class="container">
      <p class="eyebrow">Resources</p>
      <h1>Modules we build and maintain</h1>
      <p class="hero-lead">
        Ecosoft contributes to the OCA ecosystem and maintains purpose-built modules for Thai businesses.
        All modules are open-source — owned by you, not by us.
      </p>
    </div>
  </section>

  <!-- OCA NOTE -->
  <section style="background: var(--surface); padding: 1.5rem 0; border-bottom: 1px solid var(--border);">
    <div class="container">
      <div style="display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
        <span style="font-size:0.875rem; color:var(--text-muted);">
          <strong style="color:var(--text);">OCA-contributed</strong> modules are maintained in the Odoo Community Association repositories — community-reviewed and upgrade-safe.
          <strong style="color:var(--text);">Ecosoft-built</strong> modules are maintained in Ecosoft's open-source repositories under compatible licences.
        </span>
      </div>
    </div>
  </section>

  <!-- MODULES -->
  <section class="section">
    <div class="container">
      {categories.map((cat) => (
        <div style="margin-bottom:3rem;">
          <h2 style="margin-bottom:1.5rem; padding-bottom:0.75rem; border-bottom:2px solid var(--border);">{cat}</h2>
          <div class="cards-grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap:1.25rem;">
            {modules.filter(m => m.category === cat).map((mod) => (
              <div class="info-card" style="padding:1.5rem;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.75rem; flex-wrap:wrap; gap:0.5rem;">
                  <span class="tag">{mod.platform}</span>
                  <span class="tag" style={mod.oca ? "background:#dbeafe;color:#1e40af;" : "background:var(--surface);color:var(--text-muted);"}>
                    {mod.oca ? "OCA" : "Ecosoft"}
                  </span>
                </div>
                <h4 style="margin-top:0; margin-bottom:0.5rem;">{mod.name}</h4>
                <p style="font-size:0.875rem; color:var(--text-muted); margin:0;">{mod.description}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container">
      <h2>Need a module that isn't listed here?</h2>
      <p>Tell us your requirement. We'll check the OCA and ERPNext community first — often the module already exists. If not, we'll build it.</p>
      <a href="/contact" class="btn btn-primary">Discuss Your Module Requirement</a>
    </div>
  </section>

</BaseLayout>
