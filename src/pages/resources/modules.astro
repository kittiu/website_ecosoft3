---
import BaseLayout from "@layouts/BaseLayout.astro";

const modules = [
  {
    name: "Thai Accounting Localisation",
    platform: "Odoo",
    description: "VAT, ภาษีหัก ณ ที่จ่าย ผังบัญชีไทย และการรายงานต่อกรมสรรพากร ดูแลโดย OCA ด้วยการมีส่วนร่วมของ Ecosoft",
    category: "บัญชีและการเงิน",
    oca: true,
  },
  {
    name: "Budget Encumbrance Control",
    platform: "Odoo",
    description: "การจอง Encumbrance งบประมาณตามมาตรฐานภาครัฐ การติดตามงบประมาณแบบ Real-time และการป้องกันการใช้จ่ายเกินงบประมาณ ณ จุดสร้าง PO",
    category: "ภาครัฐ",
    oca: false,
  },
  {
    name: "Government Procurement",
    platform: "Odoo",
    description: "การปฏิบัติตามระเบียบการจัดซื้อจัดจ้างภาครัฐไทย — เกณฑ์วงเงินใบเสนอราคา การอนุมัติของคณะกรรมการ และการจดทะเบียนสัญญา",
    category: "ภาครัฐ",
    oca: false,
  },
  {
    name: "Multi-fund Accounting",
    platform: "Odoo",
    description: "การติดตามงบประมาณและค่าใช้จ่ายตามโครงการ แผนงาน และกองทุนพร้อมกัน รายงานการเงินตามมาตรฐานภาครัฐ",
    category: "ภาครัฐ",
    oca: false,
  },
  {
    name: "Manufacturing Extended",
    platform: "Odoo",
    description: "เวิร์กโฟลว์การผลิตที่ปรับปรุงแล้ว — การสร้าง BOM แบบกำหนดเอง การบันทึก Specification การจัดการศูนย์งาน และการคิดต้นทุนการผลิต",
    category: "การผลิต",
    oca: true,
  },
  {
    name: "Landed Cost Extended",
    platform: "Odoo",
    description: "การจัดสรร Landed Cost ขั้นสูงสำหรับผู้นำเข้า — แบ่งตามน้ำหนัก ปริมาตร หรือมูลค่าตาม Purchase Order หลายรายการ",
    category: "คลังสินค้า",
    oca: true,
  },
  {
    name: "Thai Accounting Localisation",
    platform: "ERPNext",
    description: "VAT, ภาษีหัก ณ ที่จ่าย ผังบัญชีไทย และรายงานภาษีสำหรับ ERPNext — ครอบคลุมข้อกำหนดมาตรฐานของกรมสรรพากรไทย",
    category: "บัญชีและการเงิน",
    oca: false,
  },
  {
    name: "Specification-to-BOM",
    platform: "Odoo",
    description: "โมดูลกำหนดเองสำหรับผู้ผลิตแบบ Made-to-Order — สร้าง BOM การผลิตโดยอัตโนมัติจาก Specification ของ Sales Order",
    category: "การผลิต",
    oca: false,
  },
  {
    name: "Asset Management Extended",
    platform: "Odoo",
    description: "ทะเบียนทรัพย์สินตามมาตรฐานภาครัฐ เวิร์กโฟลว์การตรวจนับทรัพย์สินจริง เอกสารการจำหน่ายและการโอนทรัพย์สิน",
    category: "ภาครัฐ",
    oca: true,
  },
  {
    name: "HR Payroll Thailand",
    platform: "Odoo",
    description: "เงินเดือนไทย — ประกันสังคม ภาษีเงินได้บุคคลธรรมดา กองทุนสำรองเลี้ยงชีพ และการรายงานเงินเดือนต่อกรมสรรพากร",
    category: "HR",
    oca: true,
  },
  {
    name: "Quality Control Extended",
    platform: "ERPNext",
    description: "เวิร์กโฟลว์การตรวจสอบคุณภาพที่ปรับปรุงแล้ว — การตั้งค่า Checkpoint การจัดการข้อไม่สอดคล้อง และการติดตามมาตรการแก้ไข",
    category: "การผลิต",
    oca: false,
  },
  {
    name: "Project Billing",
    platform: "ERPNext",
    description: "การเรียกเก็บเงินตาม Milestone การจัดการ Retainer และการสร้างใบแจ้งหนี้อัตโนมัติจาก Timesheet สำหรับธุรกิจบริการโครงการ",
    category: "บริการวิชาชีพ",
    oca: false,
  },
];

const categories = [...new Set(modules.map(m => m.category))];
---

<BaseLayout
  title="Open Source ERP Modules | Ecosoft"
  description="โมดูล Odoo และ ERPNext ที่สร้างและดูแลโดย Ecosoft — รวมถึงการมีส่วนร่วมกับ OCA สำหรับบัญชีไทย การปฏิบัติตามกฎระเบียบภาครัฐ การผลิต และ HR"
>


  <!-- HERO -->
  <section class="hero" style="padding-bottom:2rem;">
    <div class="container">
      <p class="eyebrow">ทรัพยากร</p>
      <h1>Modules we build and maintain</h1>
      <p class="hero-lead">
        Ecosoft มีส่วนร่วมกับระบบนิเวศ OCA และดูแลโมดูลที่สร้างขึ้นเฉพาะสำหรับธุรกิจไทย
        โมดูลทั้งหมดเป็น Open Source — เป็นของคุณ ไม่ใช่ของเรา
      </p>
    </div>
  </section>

  <!-- OCA NOTE -->
  <section style="background: var(--surface); padding: 1.5rem 0; border-bottom: 1px solid var(--border);">
    <div class="container">
      <div style="display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
        <span style="font-size:0.875rem; color:var(--text-muted);">
          โมดูล <strong style="color:var(--text);">OCA-contributed</strong> ดูแลอยู่ใน Repositories ของ Odoo Community Association — ผ่านการตรวจสอบโดยชุมชนและปลอดภัยสำหรับการอัปเกรด
          โมดูล <strong style="color:var(--text);">Ecosoft-built</strong> ดูแลอยู่ใน Open Source repositories ของ Ecosoft ภายใต้สัญญาอนุญาตที่เข้ากันได้
        </span>
      </div>
    </div>
  </section>

  <!-- MODULES -->
  <section class="section">
    <div class="container">
      {categories.map((cat) => (
        <div style="margin-bottom:3rem;">
          <h2 style="margin-bottom:1.5rem; padding-bottom:0.75rem; border-bottom:2px solid var(--border);">{cat}</h2>
          <div class="cards-grid" style="grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap:1.25rem;">
            {modules.filter(m => m.category === cat).map((mod) => (
              <div class="info-card" style="padding:1.5rem;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.75rem; flex-wrap:wrap; gap:0.5rem;">
                  <span class="tag">{mod.platform}</span>
                  <span class="tag" style={mod.oca ? "background:#dbeafe;color:#1e40af;" : "background:var(--surface);color:var(--text-muted);"}>
                    {mod.oca ? "OCA" : "Ecosoft"}
                  </span>
                </div>
                <h4 style="margin-top:0; margin-bottom:0.5rem;">{mod.name}</h4>
                <p style="font-size:0.875rem; color:var(--text-muted); margin:0;">{mod.description}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container">
      <h2>ต้องการโมดูลที่ไม่มีในรายการนี้หรือไม่?</h2>
      <p>บอกความต้องการของคุณมา เราจะตรวจสอบชุมชน OCA และ ERPNext ก่อน — บ่อยครั้งโมดูลที่ต้องการมีอยู่แล้ว ถ้าไม่มี เราจะสร้างให้</p>
      <a href="/contact" class="btn btn-primary">หารือความต้องการโมดูลของคุณ</a>
    </div>
  </section>

</BaseLayout>
