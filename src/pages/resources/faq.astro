---
import BaseLayout from "@layouts/BaseLayout.astro";

const faqs = [
  {
    group: "เกี่ยวกับ Ecosoft",
    items: [
      {
        q: "Ecosoft ดำเนินงานด้านการติดตั้ง ERP มานานเท่าใดแล้ว?",
        a: "ตั้งแต่ปี 2556 — การติดตั้งระบบครั้งแรกของเราคือ Raja Cycle ผู้ผลิตจักรยานไทย ระบบนั้นยังคงดำเนินงานอยู่จนถึงปัจจุบัน ผ่านการอัปเกรด Odoo หลายเวอร์ชัน เรามีประสบการณ์ ERP จากการใช้งานจริงในประเทศไทยมากกว่าหนึ่งทศวรรษ"
      },
      {
        q: "อะไรที่ทำให้ Ecosoft แตกต่างจากพาร์ทเนอร์ Odoo / ERPNext รายอื่น?",
        a: "สามสิ่งหลัก: เราเป็นผู้มีส่วนร่วมอย่างแข็งขันใน OCA (Odoo Community Association) และระบบนิเวศ ERPNext — ไม่ใช่แค่ผู้ติดตั้ง; การปรับแต่งทั้งหมดของเราสร้างขึ้นเป็น Open Source modules ที่ถูกต้อง ไม่ใช่การแก้ไขชั่วคราว; และเราปฏิบัติต่อความสัมพันธ์กับลูกค้าเป็นหุ้นส่วนระยะยาว ไม่ใช่โครงการครั้งเดียว ลูกค้าที่อยู่กับเรานานที่สุดมีความสัมพันธ์เกิน 10 ปี"
      },
      {
        q: "คุณทำงานกับลูกค้านอกประเทศไทยหรือไม่?",
        a: "ตลาดหลักของเราคือประเทศไทย และความเชี่ยวชาญด้านแพลตฟอร์มของเราเน้นที่การปฏิบัติตามกฎระเบียบไทยอย่างลึกซึ้ง เราเคยทำงานกับลูกค้าในประเทศไทยที่มีการดำเนินงานระหว่างประเทศ แต่เราไม่ใช่บริษัท ERP ทั่วไปในเอเชียตะวันออกเฉียงใต้"
      },
    ]
  },
  {
    group: "Odoo vs ERPNext",
    items: [
      {
        q: "ระบบไหนดีกว่ากัน — Odoo หรือ ERPNext?",
        a: "ไม่มีระบบใดดีกว่าอีกระบบอย่างสมบูรณ์แบบ Odoo CE มีคลังโมดูลที่ครอบคลุมกว่าและมีความแข็งแกร่งเป็นพิเศษสำหรับธุรกิจการผลิตและธุรกิจที่เน้นการขาย ERPNext มีการจัดการโครงการที่เหนือกว่าและเหมาะกว่าสำหรับธุรกิจบริการและบริษัทที่ต้องการแพลตฟอร์มที่เป็นมิตรกับนักพัฒนามากกว่า เราแนะนำระบบที่เหมาะสมสำหรับสถานการณ์เฉพาะของคุณ — เราติดตั้งทั้งสองระบบ"
      },
      {
        q: "Odoo Community Edition ฟรีจริงหรือ? มีข้อผูกมัดอะไรหรือไม่?",
        a: "ใช่ — Odoo Community Edition เผยแพร่ภายใต้สัญญาอนุญาต LGPL ไม่มีค่าธรรมเนียมสัญญาอนุญาตและไม่มีค่าใช้จ่ายต่อผู้ใช้ 'ข้อผูกมัด' คือโมดูลบางส่วนมีเฉพาะใน Odoo Enterprise (เวอร์ชันที่ต้องชำระเงิน) Ecosoft ติดตั้ง Community Edition ที่ปรับปรุงด้วย OCA-certified modules ที่ครอบคลุมช่องว่างส่วนใหญ่ — ลูกค้าส่วนใหญ่จึงไม่จำเป็นต้องใช้ Enterprise"
      },
      {
        q: "สามารถอัปเกรดระหว่างเวอร์ชันได้โดยไม่สูญเสียการปรับแต่งหรือไม่?",
        a: "ได้ — หากการปรับแต่งถูกสร้างขึ้นอย่างถูกต้อง นี่คือจุดที่แนวทางการพัฒนามาตรฐาน OCA ของ Ecosoft มีความสำคัญ การปรับแต่งที่สร้างเป็นโมดูลที่ถูกต้องจะรอดผ่านการอัปเกรดเวอร์ชัน การปรับแต่งที่แก้ไขไฟล์หลักโดยตรงจะไม่รอด Raja Cycle ได้รับการอัปเกรดผ่านหลาย Odoo major version โดยไม่สูญเสียฟังก์ชันการปรับแต่ง"
      },
    ]
  },
  {
    group: "การติดตั้งระบบ",
    items: [
      {
        q: "การติดตั้ง ERP ใช้เวลานานเท่าใด?",
        a: "การติดตั้ง ERP สำหรับ SME ที่ครอบคลุมบัญชี คลังสินค้า การจัดซื้อ และการขาย โดยทั่วไปใช้เวลา 3–5 เดือน การผลิตเพิ่มความซับซ้อน การติดตั้งภาครัฐที่มีโมดูลจัดซื้อจัดจ้างแบบกำหนดเองโดยทั่วไปใช้เวลา 6–12 เดือน ตัวแปรที่สำคัญที่สุดคือขอบเขต — และความเสี่ยงที่ใหญ่ที่สุดต่อกรอบเวลาคือการขยาย Scope ระหว่างการติดตั้ง"
      },
      {
        q: "การติดตั้งระบบของ Ecosoft ครอบคลุมอะไรบ้าง?",
        a: "การวิเคราะห์ความต้องการและค้นหาข้อกำหนด การตั้งค่าระบบ การพัฒนาโมดูลกำหนดเอง (เมื่อจำเป็น) การโอนย้ายข้อมูลจากระบบเดิมของคุณ การฝึกอบรมผู้ใช้ และการสนับสนุนหลัง Go-Live เราไม่ส่งมอบระบบที่ตั้งค่าแล้วแล้วหายไป — เราอยู่ตลอดช่วงการ Stabilise ระบบ"
      },
      {
        q: "คุณสามารถโอนย้ายข้อมูลจากระบบปัจจุบันของเราได้หรือไม่?",
        a: "ได้ — การโอนย้ายข้อมูลรวมอยู่ในการติดตั้งทั้งหมด ความซับซ้อนขึ้นอยู่กับระบบปัจจุบันของคุณ (การส่งออกจาก SAP ตรงไปตรงมา; สเปรดชีตที่มีโครงสร้างไม่ดีต้องใช้งานมากกว่า) เราดูแล Migration Scripts การทำความสะอาดข้อมูล และการตรวจสอบความถูกต้อง"
      },
      {
        q: "คุณให้การสนับสนุนอย่างต่อเนื่องหลัง Go-Live หรือไม่?",
        a: "ใช่ — ลูกค้าทุกรายได้รับข้อเสนอสัญญาสนับสนุนรายปีหลังจากการติดตั้ง ครอบคลุมการแก้ไขข้อผิดพลาด การเปลี่ยนแปลงการตั้งค่าเล็กน้อย การตรวจสอบระบบ และการเข้าถึงทีม Ecosoft เพื่อขอคำแนะนำ ลูกค้าหลายรายอยู่กับสัญญาสนับสนุนมานาน 5–10+ ปี"
      },
    ]
  },
  {
    group: "ราคาและค่าใช้จ่าย",
    items: [
      {
        q: "การติดตั้งระบบของ Ecosoft มีค่าใช้จ่ายเท่าใด?",
        a: "ค่าใช้จ่ายในการติดตั้งขึ้นอยู่กับขอบเขต — จำนวนโมดูล ระดับการปรับแต่ง ความซับซ้อนของข้อมูล และจำนวนผู้ใช้ที่ต้องฝึกอบรม เราไม่เผยแพร่ราคาคงที่เพราะการติดตั้งแต่ละครั้งแตกต่างกัน ดูหน้าราคาของเราสำหรับช่วงราคาโดยประมาณ หรือติดต่อเราเพื่อขอข้อเสนอที่กำหนดตามขอบเขต"
      },
      {
        q: "มีค่าธรรมเนียมสัญญาอนุญาตอย่างต่อเนื่องหรือไม่?",
        a: "ไม่มีค่าธรรมเนียมสัญญาอนุญาตอย่างต่อเนื่องสำหรับ Odoo CE หรือ ERPNext — ระบบเหล่านี้เป็น Open Source คุณจ่ายสำหรับบริการติดตั้งของ Ecosoft และเลือกได้ว่าจะทำสัญญาสนับสนุนรายปีหรือไม่ ไม่มีค่าใช้จ่ายต่อผู้ใช้ที่ขยายตามจำนวนพนักงาน"
      },
      {
        q: "ราคาของคุณเทียบกับ SAP หรือ Oracle อย่างไร?",
        a: "ต่ำกว่าอย่างมีนัยสำคัญ — ทั้งค่าติดตั้งและค่าใช้จ่ายต่อเนื่อง สวทช. เปลี่ยนจาก SAP เป็น Odoo ในปี 2561 และนำเงินที่ประหยัดได้จากค่าสัญญาอนุญาตรายปีไปลงทุนในการพัฒนาระบบ เราไม่สามารถให้อัตราส่วนสากลได้เพราะค่าใช้จ่ายของ SAP/Oracle แตกต่างกันมาก แต่ Open Source ERP มีราคาเพียงเศษเสี้ยวของระบบที่เป็น Proprietary ที่เทียบเท่า"
      },
    ]
  },
  {
    group: "เทคนิคและระบบ",
    items: [
      {
        q: "ระบบโฮสต์ที่ไหน — Cloud หรือ On-Premise?",
        a: "Ecosoft ติดตั้งได้ทั้งสองรูปแบบ เราดูแลการโฮสต์บน Cloud Infrastructure (โดยทั่วไปคือ AWS หรือ Azure) หรือ On-Premise ที่ Data Centre ของลูกค้า ลูกค้าส่วนใหญ่ชอบการโฮสต์บน Cloud เพื่อความสะดวก; หน่วยงานภาครัฐและสถาบันการเงินมักชอบ On-Premise เพื่อความอธิปไตยของข้อมูล"
      },
      {
        q: "จะเกิดอะไรขึ้นถ้า Ecosoft ปิดตัวลง?",
        a: "ไม่มีอะไรที่เป็นหายนะ — เพราะซอฟต์แวร์เป็น Open Source และการปรับแต่งเป็นของคุณ คุณมีซอร์สโค้ดของแพลตฟอร์มและโมดูลกำหนดเองทั้งหมด นักพัฒนา Odoo หรือ ERPNext ที่มีความสามารถคนใดก็สามารถรับช่วงต่อจากที่เราทำค้างไว้ได้ นี่เป็นการตัดสินใจออกแบบโดยเจตนา ไม่ใช่เรื่องบังเอิญ"
      },
      {
        q: "เราสามารถผสานรวม ERP กับระบบที่มีอยู่ได้หรือไม่?",
        a: "ได้ — ทั้ง Odoo และ ERPNext เปิดเผย REST API ที่ครอบคลุม Ecosoft ได้สร้างการผสานรวมกับแพลตฟอร์ม E-Commerce, Logistics API, ฟีดธนาคาร, พอร์ทัลภาครัฐ และแอปพลิเคชันทางธุรกิจกำหนดเอง ความซับซ้อนของการผสานรวมจะถูกกำหนดขอบเขตในช่วงการค้นหาข้อกำหนด"
      },
    ]
  },
];
---

<BaseLayout
  title="FAQ — คำถามที่พบบ่อย | Ecosoft"
  description="คำตอบสำหรับคำถามทั่วไปเกี่ยวกับ Ecosoft, Odoo, ERPNext, กรอบเวลาการติดตั้ง ราคา และ Open Source ERP สำหรับธุรกิจไทย"
>


  <!-- HERO -->
  <section class="hero" style="padding-bottom:2rem;">
    <div class="container">
      <p class="eyebrow">ทรัพยากร</p>
      <h1>Frequently asked questions</h1>
      <p class="hero-lead">
        คำตอบที่ตรงไปตรงมาสำหรับคำถามที่เราได้ยินบ่อยที่สุด — เกี่ยวกับ Ecosoft, แพลตฟอร์มของเรา,
        การติดตั้งระบบ และ Open Source ERP มีค่าใช้จ่ายอย่างไรในความเป็นจริง
      </p>
    </div>
  </section>

  <!-- FAQ GROUPS -->
  <section class="section">
    <div class="container">
      <div style="max-width:860px; margin:0 auto; display:flex; flex-direction:column; gap:3rem;">
        {faqs.map((group) => (
          <div class="faq-group">
            <h2 style="margin-bottom:1.5rem;">{group.group}</h2>
            {group.items.map((item) => (
              <details class="faq-item">
                <summary class="faq-question">
                  {item.q}
                  <span class="faq-chevron">›</span>
                </summary>
                <div class="faq-answer">
                  <p>{item.a}</p>
                </div>
              </details>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container">
      <h2>ยังมีคำถามเพิ่มเติมอยู่หรือไม่?</h2>
      <p>พูดคุยกับที่ปรึกษาโดยตรง — เราจะให้คำตอบที่ตรงไปตรงมา แม้จะหมายความว่า ERP ยังไม่ใช่ทางออกที่เหมาะสมสำหรับคุณในตอนนี้</p>
      <a href="/contact" class="btn btn-primary">ถามเราโดยตรง</a>
    </div>
  </section>

</BaseLayout>

<style>
  .faq-item summary { list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
</style>
