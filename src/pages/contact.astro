---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="ติดต่อเรา | Ecosoft"
  description="เริ่มต้นบทสนทนากับ Ecosoft โดยไม่มีข้อผูกมัด ไม่มีการขายแบบกดดัน — เพียงการพูดคุยอย่างตรงไปตรงมาเกี่ยวกับเป้าหมาย ERP ของคุณ"
>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div style="max-width: 42rem;">
        <p class="eyebrow">ติดต่อเรา</p>
        <h1>Let's start with a conversation. No obligation, no hard sell.</h1>
        <p class="hero-lead">
          บอกเราเกี่ยวกับธุรกิจและระบบที่คุณใช้อยู่ในปัจจุบัน ทีมงานของเราจะตอบกลับภายในหนึ่งวันทำการ
          พร้อมการประเมินเบื้องต้นและขั้นตอนถัดไปโดยไม่มีข้อผูกมัด
        </p>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM + INFO -->
  <section class="section section-accent">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow eyebrow-light">สิ่งที่คุณจะได้รับ</p>
        <h2>เราตอบกลับภายในหนึ่งวันทำการ</h2>
        <p>
          กรอกแบบฟอร์มแล้วที่ปรึกษาอาวุโสของเราจะติดต่อกลับโดยตรง
          เราไม่ส่งต่อคำถามไปยังทีมขาย — คุณจะได้พูดคุยโดยตรงกับผู้ที่จะรับผิดชอบโครงการของคุณ
        </p>
        <ul class="contact-meta">
          <li>การให้คำปรึกษาและ demo เบื้องต้นฟรี</li>
          <li>การประเมินความพร้อม ERP และ ROI</li>
          <li>การวางแผนการย้ายระบบและการติดตั้ง</li>
          <li>คำแนะนำที่ตรงไปตรงมา — Odoo หรือ ERPNext</li>
        </ul>
        <div style="margin-top: 2rem; padding: 1.25rem 1.5rem; background: rgba(255,255,255,0.15); border-radius: 0.75rem; font-size: 0.9rem;">
          <p style="margin: 0 0 0.4rem; font-weight: 700;">ช่องทางติดต่ออื่น</p>
          <p style="margin: 0 0 0.2rem;">📧 sales@ecosoft.co.th</p>
          <p style="margin: 0 0 0.2rem;">📞 +66 81 841 7480</p>
          <p style="margin: 0;">📍 459/132 ถนนสุขสวัสดิ์ ราษฎร์บูรณะ กรุงเทพฯ 10140</p>
        </div>
      </div>
      <form class="contact-form" id="contact-form" novalidate>
        <div class="form-row">
          <label for="contact-name">
            ชื่อ-นามสกุล <span aria-hidden="true">*</span>
            <input id="contact-name" type="text" name="name" placeholder="ชื่อ-นามสกุลของคุณ" required />
          </label>
          <label for="contact-company">
            บริษัท <span aria-hidden="true">*</span>
            <input id="contact-company" type="text" name="company" placeholder="ชื่อบริษัท" required />
          </label>
        </div>
        <div class="form-row">
          <label for="contact-email">
            อีเมล <span aria-hidden="true">*</span>
            <input id="contact-email" type="email" name="email" placeholder="you@company.com" required />
          </label>
          <label for="contact-phone">
            เบอร์โทรศัพท์ <span style="font-weight:400; color: var(--text-faint);">(ไม่บังคับ)</span>
            <input id="contact-phone" type="tel" name="phone" placeholder="+66 ..." />
          </label>
        </div>
        <div class="form-row">
          <label for="contact-size">
            ขนาดบริษัท
            <select id="contact-size" name="company_size" style="border-radius: 0.6rem; border: 1px solid var(--input-border); background: var(--input-bg); color: var(--text); padding: 0.55rem 0.7rem; font: inherit; width: 100%;">
              <option value="">เลือก...</option>
              <option>1 – 20 คน</option>
              <option>20 – 100 คน</option>
              <option>100 – 500 คน</option>
              <option>500+ คน</option>
            </select>
          </label>
          <label for="contact-industry">
            อุตสาหกรรม
            <select id="contact-industry" name="industry" style="border-radius: 0.6rem; border: 1px solid var(--input-border); background: var(--input-bg); color: var(--text); padding: 0.55rem 0.7rem; font: inherit; width: 100%;">
              <option value="">เลือก...</option>
              <option>Manufacturing</option>
              <option>Government / NGO</option>
              <option>Trading &amp; Retail</option>
              <option>Technology</option>
              <option>Professional Services</option>
              <option>Healthcare</option>
              <option>อื่นๆ</option>
            </select>
          </label>
        </div>
        <label for="contact-system">
          ระบบที่ใช้อยู่ในปัจจุบัน
          <input id="contact-system" type="text" name="current_system" placeholder="เช่น SAP, spreadsheets, โปรแกรมบัญชี, ยังไม่มี" />
        </label>
        <label for="contact-message">
          คุณต้องการบรรลุเป้าหมายอะไร? <span aria-hidden="true">*</span>
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            placeholder="อธิบายปัญหาที่พบ เป้าหมาย และระยะเวลาที่ต้องการ"
            required
          ></textarea>
        </label>
        <label for="contact-source">
          คุณรู้จักเราจากที่ไหน?
          <select id="contact-source" name="source" style="border-radius: 0.6rem; border: 1px solid var(--input-border); background: var(--input-bg); color: var(--text); padding: 0.55rem 0.7rem; font: inherit; width: 100%;">
            <option value="">เลือก...</option>
            <option>ค้นหาจาก Google</option>
            <option>LinkedIn</option>
            <option>คนรู้จักแนะนำ</option>
            <option>งานสัมมนา / งานแสดงสินค้า</option>
            <option>อื่นๆ</option>
          </select>
        </label>
        <div id="form-success" class="form-success" hidden>
          ขอบคุณ! เราจะติดต่อกลับภายในหนึ่งวันทำการ
        </div>
        <button type="submit" class="btn btn-primary btn-full">
          ส่งข้อความ
        </button>
        <p class="form-note">
          ข้อมูลของคุณจะถูกเก็บเป็นความลับอย่างเคร่งครัด และใช้เพื่อตอบกลับคำถามของคุณเท่านั้น
        </p>
      </form>
      <script is:inline>
        (function () {
          var form = document.getElementById('contact-form');
          if (!form) return;
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!form.checkValidity()) { form.reportValidity(); return; }
            var success = document.getElementById('form-success');
            if (success) success.removeAttribute('hidden');
            form.reset();
          });
        })();
      </script>
    </div>
  </section>

</BaseLayout>
