---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="ติดต่อเรา | Ecosoft"
  description="เริ่มต้นบทสนทนากับ Ecosoft โดยไม่มีข้อผูกมัด ไม่มีการขายแบบกดดัน — เพียงการพูดคุยอย่างตรงไปตรงมาเกี่ยวกับเป้าหมาย ERP ของคุณ"
>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div style="max-width: 42rem;">
        <p class="eyebrow">ติดต่อเรา</p>
        <h1>Let's start with a conversation.<br/>No obligation, no hard sell.</h1>
      </div>


      <div class="cards-grid cards-grid-3" style="align-items: stretch;">

        <!-- Card 1: Contact Info -->
        <div class="info-card" style="display: flex; flex-direction: column; gap: 0.75rem;">
          <h3 style="margin: 0; font-size: 1.1rem;">Ecosoft Co., Ltd.</h3>
          <p style="margin: 0; font-size: 0.9rem; line-height: 1.6; color: var(--text-muted);">
            459/132 ถนนสุขสวัสดิ์<br />
            ราษฎร์บูรณะ กรุงเทพฯ 10140
          </p>
          <div style="font-size: 0.9rem; display: flex; flex-direction: column; gap: 0.4rem;">
            <a href="mailto:sales@ecosoft.co.th" style="color: var(--text); text-decoration: none;">
              📧 sales@ecosoft.co.th
            </a>
            <a href="tel:+66818417480" style="color: var(--text); text-decoration: none;">
              📞 +66 81 841 7480
            </a>
          </div>
          <div style="margin-top: auto; padding-top: 0.75rem; font-size: 0.85rem; color: var(--text-muted);">
            เปิดทำการ จันทร์ – ศุกร์ เวลา 09:00 – 18:00 น.
          </div>
        </div>

        <!-- Card 2: CTA -->
        <div class="info-card section-accent" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 1.25rem; padding: 2rem 1.5rem;">
          <div style="font-size: 2.5rem;">💬</div>
          <h3 style="margin: 0; font-size: 1.15rem; color: var(--text-muted);">
            พร้อมคุยแล้วใช่ไหม?
          </h3>
          <a
            href="https://ecosoft.frappe.cloud/contact-us/new"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            style="font-size: 0.95rem; padding: 0.75rem 1.5rem; width: 100%; text-align: center;"
          >
            แจ้งรายละเอียดให้เราติดต่อกลับ
          </a>
          <p style="margin: 0; font-size: 0.8rem; color: var(--text-muted-on-accent, rgba(255,255,255,0.6));">
            ฟรี ไม่มีข้อผูกมัด
          </p>
        </div>
        <!-- Card 3: Map -->
        <div class="info-card" style="padding: 0; overflow: hidden; min-height: 280px;">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3876.83030032625!2d100.51213107567237!3d13.668080699225111!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x30e29f2c65e4467b%3A0xb4765fc451747e3f!2sEcosoft%20Co.%2C%20Ltd.%20Your%20ERP%20Partner!5e0!3m2!1sen!2sth!4v1775198573152!5m2!1sen!2sth"
            width="100%"
            height="100%"
            style="border: 0; display: block; min-height: 280px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ecosoft office location"
          ></iframe>
        </div>


      </div>

    </div>
  </section>

</BaseLayout>
