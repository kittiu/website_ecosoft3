---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="แบบประเมินความพร้อม ERP | Ecosoft"
  description="แบบประเมินตนเองฟรีภายใน 5 นาที เพื่อวัดความพร้อมของธุรกิจในการวางระบบ ERP — ครอบคลุมความสมบูรณ์ของกระบวนการ คุณภาพข้อมูล และความพร้อมขององค์กร"
>

  <!-- HERO -->
  <section class="hero" style="padding-bottom:2rem;">
    <div class="container" style="text-align:center;">
      <p class="eyebrow">เครื่องมือฟรี</p>
      <h1>Is your business ready for ERP?</h1>
      <p class="hero-lead" style="max-width:640px; margin:1rem auto 0;">
        5 นาที 15 คำถาม ประเมินสถานะปัจจุบันของคุณอย่างชัดเจน และสิ่งที่ต้องเตรียมก่อนเริ่มติดตั้งระบบ
      </p>
    </div>
  </section>

  <!-- ASSESSMENT FORM -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <div style="max-width:720px; margin:0 auto;">

        <!-- PROGRESS -->
        <div class="step-form-progress" id="progress-bar" style="margin-bottom:2.5rem;">
          <div class="step-dot step-dot--active" data-step="1">1</div>
          <div class="step-dot" data-step="2">2</div>
          <div class="step-dot" data-step="3">3</div>
          <div class="step-dot" data-step="4">4</div>
          <div class="step-dot" data-step="5">5</div>
        </div>

        <form id="readiness-form">

          <!-- STEP 1: Business context -->
          <div class="step-panel step-panel--active" id="step-1">
            <h2>ข้อมูลธุรกิจของคุณ</h2>

            <div style="margin-bottom:1.5rem;">
              <label style="display:block; font-weight:600; margin-bottom:0.5rem;">ขนาดบริษัท</label>
              <select name="size" class="form-input" required>
                <option value="">เลือก…</option>
                <option>ต่ำกว่า 20 คน</option>
                <option>20–50 คน</option>
                <option>50–100 คน</option>
                <option>100–500 คน</option>
                <option>500+ คน</option>
              </select>
            </div>

            <div style="margin-bottom:1.5rem;">
              <label style="display:block; font-weight:600; margin-bottom:0.5rem;">อุตสาหกรรม</label>
              <select name="industry" class="form-input" required>
                <option value="">เลือก…</option>
                <option>Manufacturing</option>
                <option>Trading / Distribution</option>
                <option>Professional Services</option>
                <option>Technology</option>
                <option>Government / Public sector</option>
                <option>Healthcare</option>
                <option>อื่นๆ</option>
              </select>
            </div>

            <div style="margin-bottom:1.5rem;">
              <label style="display:block; font-weight:600; margin-bottom:0.5rem;">ระบบที่ใช้อยู่ในปัจจุบันสำหรับบัญชี / การดำเนินงาน</label>
              <select name="current_system" class="form-input" required>
                <option value="">เลือก…</option>
                <option>Spreadsheets (Excel / Google Sheets)</option>
                <option>โปรแกรมบัญชีพื้นฐาน (QuickBooks, Xero, PEAK)</option>
                <option>โปรแกรมบัญชีไทย (Express, FlowAccount)</option>
                <option>ERP รุ่นเก่า (SAP, Oracle, Microsoft Dynamics)</option>
                <option>Odoo (เวอร์ชันปัจจุบัน — ต้องการอัปเกรด)</option>
                <option>ERPNext (เวอร์ชันปัจจุบัน — ต้องการอัปเกรด)</option>
                <option>ยังไม่มีระบบที่เป็นทางการ</option>
              </select>
            </div>

            <button type="button" class="btn btn-primary next-step" data-next="2">ถัดไป →</button>
          </div>

          <!-- STEP 2: Process maturity -->
          <div class="step-panel" id="step-2">
            <h2>ความสมบูรณ์ของกระบวนการ</h2>
            <p style="color:var(--text-muted); margin-bottom:1.5rem;">ให้คะแนนความเห็นด้วยกับแต่ละข้อความ (1 = ไม่เห็นด้วยอย่างยิ่ง, 5 = เห็นด้วยอย่างยิ่ง)</p>

            {[
              { name: "q_process_1", text: "กระบวนการทางธุรกิจหลักของเรา (การจัดการคำสั่งซื้อ การจัดซื้อ การผลิต) ได้รับการบันทึกอย่างชัดเจนและปฏิบัติตามอย่างสม่ำเสมอ" },
              { name: "q_process_2", text: "เรามีผู้รับผิดชอบที่ชัดเจนสำหรับกระบวนการทางธุรกิจหลักแต่ละกระบวนการ — มีบุคคลที่รับผิดชอบว่ากระบวนการทำงานอย่างไรและปฏิบัติตามหรือไม่" },
              { name: "q_process_3", text: "เมื่อเกิดปัญหาด้านการดำเนินงาน เรามีวิธีมาตรฐานในการระบุสาเหตุที่แท้จริง ไม่ใช่แค่แก้ไขที่อาการ" },
            ].map((q) => (
              <div style="margin-bottom:1.5rem; padding:1.25rem; background:var(--surface); border-radius:0.75rem; border:1px solid var(--border);">
                <label style="display:block; font-weight:600; margin-bottom:1rem;">{q.text}</label>
                <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
                  {[1,2,3,4,5].map((v) => (
                    <label style="display:flex; align-items:center; gap:0.4rem; cursor:pointer;">
                      <input type="radio" name={q.name} value={v} required style="accent-color:var(--accent);" />
                      <span style="font-size:0.875rem;">{v}</span>
                    </label>
                  ))}
                </div>
              </div>
            ))}

            <div style="display:flex; gap:1rem;">
              <button type="button" class="btn btn-outline prev-step" data-prev="1">← ย้อนกลับ</button>
              <button type="button" class="btn btn-primary next-step" data-next="3">ถัดไป →</button>
            </div>
          </div>

          <!-- STEP 3: Data readiness -->
          <div class="step-panel" id="step-3">
            <h2>ความพร้อมของข้อมูล</h2>
            <p style="color:var(--text-muted); margin-bottom:1.5rem;">ให้คะแนนความเห็นด้วยกับแต่ละข้อความ</p>

            {[
              { name: "q_data_1", text: "เรามีรายชื่อสินค้า/บริการที่จำหน่ายครบถ้วนและค่อนข้างถูกต้อง พร้อมข้อมูลราคาและต้นทุน" },
              { name: "q_data_2", text: "ข้อมูลผู้ขายและลูกค้าของเรามีการจัดระเบียบและค่อนข้างทันสมัย ไม่กระจัดกระจายอยู่ใน spreadsheet หลายชุดหรือรายชื่อติดต่อส่วนตัว" },
              { name: "q_data_3", text: "เราสามารถนับสต็อกสินค้าได้อย่างแม่นยำพอสมควรหากต้องทำในวันนี้" },
            ].map((q) => (
              <div style="margin-bottom:1.5rem; padding:1.25rem; background:var(--surface); border-radius:0.75rem; border:1px solid var(--border);">
                <label style="display:block; font-weight:600; margin-bottom:1rem;">{q.text}</label>
                <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
                  {[1,2,3,4,5].map((v) => (
                    <label style="display:flex; align-items:center; gap:0.4rem; cursor:pointer;">
                      <input type="radio" name={q.name} value={v} required style="accent-color:var(--accent);" />
                      <span style="font-size:0.875rem;">{v}</span>
                    </label>
                  ))}
                </div>
              </div>
            ))}

            <div style="display:flex; gap:1rem;">
              <button type="button" class="btn btn-outline prev-step" data-prev="2">← ย้อนกลับ</button>
              <button type="button" class="btn btn-primary next-step" data-next="4">ถัดไป →</button>
            </div>
          </div>

          <!-- STEP 4: Organisational readiness -->
          <div class="step-panel" id="step-4">
            <h2>ความพร้อมขององค์กร</h2>
            <p style="color:var(--text-muted); margin-bottom:1.5rem;">ให้คะแนนความเห็นด้วยกับแต่ละข้อความ</p>

            {[
              { name: "q_org_1", text: "ผู้บริหารระดับสูงสนับสนุนโครงการ ERP นี้อย่างจริงจัง ไม่ใช่แค่ยอมรับ" },
              { name: "q_org_2", text: "เราได้ระบุผู้รับผิดชอบโครงการภายในที่มีความสามารถ และจะมีเวลาอุทิศให้กับโครงการนี้ระหว่างการวางระบบ" },
              { name: "q_org_3", text: "ธุรกิจสามารถรับมือกับช่วงเรียนรู้และความเร็วที่ลดลงระหว่างการเปลี่ยนระบบ — เรามีมุมมองที่สมเหตุสมผลเกี่ยวกับสิ่งที่การวางระบบต้องใช้" },
              { name: "q_org_4", text: "เรามีงบประมาณที่สมเหตุสมผลสำหรับบริการวางระบบ — ไม่ใช่แค่ค่าลิขสิทธิ์ซอฟต์แวร์" },
            ].map((q) => (
              <div style="margin-bottom:1.5rem; padding:1.25rem; background:var(--surface); border-radius:0.75rem; border:1px solid var(--border);">
                <label style="display:block; font-weight:600; margin-bottom:1rem;">{q.text}</label>
                <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
                  {[1,2,3,4,5].map((v) => (
                    <label style="display:flex; align-items:center; gap:0.4rem; cursor:pointer;">
                      <input type="radio" name={q.name} value={v} required style="accent-color:var(--accent);" />
                      <span style="font-size:0.875rem;">{v}</span>
                    </label>
                  ))}
                </div>
              </div>
            ))}

            <div style="display:flex; gap:1rem;">
              <button type="button" class="btn btn-outline prev-step" data-prev="3">← ย้อนกลับ</button>
              <button type="button" class="btn btn-primary next-step" data-next="5">ดูผลลัพธ์ของคุณ →</button>
            </div>
          </div>

          <!-- STEP 5: Results + Contact -->
          <div class="step-panel" id="step-5">
            <h2>ผลการประเมินความพร้อม ERP ของคุณ</h2>
            <div id="results-display" style="background:var(--surface); border-radius:1rem; padding:2rem; margin-bottom:2rem; border:1px solid var(--border);">
              <div id="score-display" style="text-align:center; margin-bottom:1.5rem;">
                <div id="score-number" style="font-size:4rem; font-weight:700; color:var(--accent);">—</div>
                <div style="color:var(--text-muted); font-size:0.875rem;">คะแนนความพร้อมโดยรวม</div>
              </div>
              <div id="score-message" style="text-align:center;"></div>
            </div>

            <div class="info-card" style="padding:2rem; margin-bottom:2rem;">
              <h3 style="margin-top:0;">รับรายงานการประเมินฉบับเต็ม</h3>
              <p>กรอกข้อมูลของคุณ แล้วเราจะส่งรายงานเฉพาะบุคคลพร้อมคำแนะนำที่เจาะจงตามคำตอบของคุณ — และนัดหมายพูดคุย 30 นาทีเพิ่มเติม (ไม่บังคับ)</p>
              <div style="display:flex; flex-direction:column; gap:1rem; margin-top:1.25rem;">
                <input type="text" name="contact_name" placeholder="ชื่อของคุณ" class="form-input" required />
                <input type="email" name="contact_email" placeholder="อีเมลธุรกิจ" class="form-input" required />
                <input type="text" name="contact_company" placeholder="ชื่อบริษัท" class="form-input" required />
                <button type="submit" class="btn btn-primary">ส่งรายงานให้ฉัน →</button>
              </div>
            </div>

            <p style="font-size:0.8125rem; text-align:center; color:var(--text-muted);">ไม่มี spam เราจะติดต่อเฉพาะเรื่องผลการประเมินของคุณเท่านั้น</p>
          </div>

        </form>

        <!-- SUCCESS STATE -->
        <div id="form-success" style="display:none; text-align:center; padding:3rem 1rem;">
          <div style="font-size:4rem; margin-bottom:1rem;">✅</div>
          <h2>รายงานกำลังส่งให้คุณแล้ว</h2>
          <p style="color:var(--text-muted); max-width:480px; margin:1rem auto 2rem;">
            เราได้รับแบบประเมินของคุณแล้ว คุณจะได้รับรายงานเฉพาะบุคคลภายในหนึ่งวันทำการ
            หากต้องการพูดคุยกับที่ปรึกษาโดยตรง สามารถนัดหมายได้ที่นี่
          </p>
          <a href="/book-demo" class="btn btn-primary">จองการปรึกษา 45 นาที</a>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // Step navigation
  var steps = document.querySelectorAll('.step-panel');
  var dots = document.querySelectorAll('.step-dot');

  function showStep(n: number) {
    steps.forEach(function(s) { s.classList.remove('step-panel--active'); });
    dots.forEach(function(d) { d.classList.remove('step-dot--active'); });
    var panel = document.getElementById('step-' + n);
    if (panel) panel.classList.add('step-panel--active');
    var dot = document.querySelector('[data-step="' + n + '"]');
    if (dot) dot.classList.add('step-dot--active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  document.querySelectorAll('.next-step').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var next = parseInt((btn as HTMLElement).getAttribute('data-next') || '1');
      if (next === 5) calculateScore();
      showStep(next);
    });
  });

  document.querySelectorAll('.prev-step').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var prev = parseInt((btn as HTMLElement).getAttribute('data-prev') || '1');
      showStep(prev);
    });
  });

  function calculateScore() {
    var form = document.getElementById('readiness-form') as HTMLFormElement;
    var total = 0;
    var count = 0;
    var questions = ['q_process_1','q_process_2','q_process_3','q_data_1','q_data_2','q_data_3','q_org_1','q_org_2','q_org_3','q_org_4'];
    questions.forEach(function(q) {
      var selected = form.querySelector('input[name="' + q + '"]:checked') as HTMLInputElement;
      if (selected) { total += parseInt(selected.value); count++; }
    });
    var pct = count > 0 ? Math.round((total / (count * 5)) * 100) : 0;
    var scoreEl = document.getElementById('score-number');
    var msgEl = document.getElementById('score-message');
    if (scoreEl) scoreEl.textContent = pct + '%';
    if (msgEl) {
      if (pct >= 70) {
        msgEl.innerHTML = '<strong style="color:var(--accent)">ความพร้อมสูง</strong><p style="color:var(--text-muted);margin-top:0.5rem;">ธุรกิจของคุณมีความพร้อมสำหรับ ERP เป็นอย่างดี ขั้นตอนต่อไปคือการพูดคุยเพื่อกำหนดขอบเขตโครงการอย่างละเอียดและเลือกแนวทางการวางระบบที่เหมาะสม</p>';
      } else if (pct >= 45) {
        msgEl.innerHTML = '<strong style="color:#f59e0b">ความพร้อมระดับปานกลาง</strong><p style="color:var(--text-muted);margin-top:0.5rem;">บางด้านต้องการการพัฒนาก่อนเริ่มติดตั้ง รายงานของคุณจะระบุช่องว่างที่เจาะจงและสิ่งที่ต้องดำเนินการ</p>';
      } else {
        msgEl.innerHTML = '<strong style="color:#ef4444">พบช่องว่างด้านความพร้อม</strong><p style="color:var(--text-muted);margin-top:0.5rem;">มีช่องว่างสำคัญที่ต้องแก้ไขก่อนเริ่มติดตั้ง ERP รายงานจะอธิบายว่าต้องแก้ไขอะไรก่อน — และเหตุผลที่การรีบเร่งจะมีต้นทุนสูง</p>';
      }
    }
  }

  // Form submit
  var form = document.getElementById('readiness-form') as HTMLFormElement;
  var successEl = document.getElementById('form-success');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      form.style.display = 'none';
      if (successEl) successEl.style.display = 'block';
    });
  }
</script>
