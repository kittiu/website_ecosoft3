---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Ecosoft | Enterprise ERP. Open Source. Zero Vendor Lock-In."
  description="Thailand's leading open-source ERP implementor — specialising in Odoo and ERPNext. 10+ years, 40+ projects, 0 failed implementations."
>

  <!-- 1.1 HERO -->
  <section class="hero hero--main">
    <canvas id="hero-canvas" aria-hidden="true"></canvas>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Thailand's Leading Open-Source ERP Partner</p>
        <h1>Enterprise ERP. Open Source. Zero Vendor Lock-In.</h1>
        <p class="hero-lead">
          Proven by 10+ years, 40+ projects, and 0 failed implementations.
          Ecosoft combines deep business consulting expertise with genuine
          open-source engineering — so your ERP is built right, the first time,
          and belongs to you entirely.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">Book a Free Consultation</a>
          <a href="/why-ecosoft/our-approach" class="btn btn-outline">See How We Work →</a>
        </div>
        <div class="hero-metas">
          <div>
            <p class="metric-number">10+</p>
            <p class="metric-label">years in business</p>
          </div>
          <div>
            <p class="metric-number">40+</p>
            <p class="metric-label">projects delivered</p>
          </div>
          <div>
            <p class="metric-number">4,000+</p>
            <p class="metric-label">deployed users</p>
          </div>
          <div>
            <p class="metric-number">120+</p>
            <p class="metric-label">open source modules</p>
          </div>
        </div>
      </div>
      <div class="hero-card">
        <div class="hero-card-main">
          <h2>What makes us different</h2>
          <ul>
            <li>OCA member &amp; certified ERPNext partner</li>
            <li>Deep Thai accounting &amp; VAT compliance expertise</li>
            <li>Full source code delivered — no lock-in, ever</li>
            <li>100% project success rate across 40+ implementations</li>
          </ul>
        </div>
        <div class="hero-card-badges">
          <span>OCA Certified</span>
          <span>ERPNext Partner</span>
          <span>100% Open Source</span>
          <span>0 Failed Projects</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TECHNOLOGY PARTNERS -->
  <section class="section tech-section">
    <div class="container">
      <p class="eyebrow eyebrow-centered">Our Technology Partners</p>
      <div class="tech-logos">
        <div class="tech-logo-item">
          <img src="/images/odoo-logo.png" alt="Odoo" />
        </div>
        <div class="tech-logo-item">
          <img src="/images/oca-logo.png" alt="OCA" />
        </div>
        <div class="tech-logo-item">
          <img src="/images/frappe-logo.png" alt="Frappe" />
        </div>
        <div class="tech-logo-item">
          <img src="/images/erpnext-logo.png" alt="ERPNext" />
        </div>
      </div>
    </div>
  </section>

  <!-- 1.3 THE PROBLEM WE SOLVE -->
  <section class="section">
    <div class="container" style="max-width: 48rem;">
      <p class="eyebrow">The Problem We Solve</p>
      <h2 style="font-size: 1.7rem; letter-spacing: -0.03em; margin: 0 0 1rem;">
        Most ERP projects fail — not because of bad software, but because of poor implementation.
      </h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.7; margin-bottom: 0.75rem;">
        Most ERP projects fail because implementors don't understand your business deeply enough.
        You end up paying for a system that doesn't match how your company actually works, locked
        into proprietary code you can never truly own.
      </p>
      <p style="color: var(--text); font-weight: 500; font-size: 0.95rem;">
        Ecosoft is different. We combine 10 years of hands-on business consulting in supply chain
        and accounting with genuine open-source engineering expertise — so your ERP is built right,
        the first time, and belongs to you entirely.
      </p>
    </div>
  </section>

  <!-- 1.4 WHY ECOSOFT — FOUR PILLARS -->
  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Why Ecosoft</p>
        <h2>Four reasons our clients choose us — and stay with us</h2>
      </header>
      <div class="cards-grid">
        <article class="info-card pillar-card">
          <span class="pillar-number">01</span>
          <h3>Business Expertise, Not Just Technology</h3>
          <p>Our consultants have worked inside supply chain, procurement, inventory, and accounting operations. We understand Thai accounting standards, Thai VAT compliance, and how businesses actually run.</p>
        </article>
        <article class="info-card pillar-card">
          <span class="pillar-number">02</span>
          <h3>100% Project Success Rate</h3>
          <p>Over 40 completed implementations across manufacturing, government, trading, and technology sectors. Not one failed project. This is our operating record — not a marketing claim.</p>
        </article>
        <article class="info-card pillar-card">
          <span class="pillar-number">03</span>
          <h3>True Open Source — You Own Everything</h3>
          <p>When your project closes, you receive all source code. No licence fees. No annual vendor payments. No lock-in. Systems you can maintain, extend, and hand to any developer in the world.</p>
        </article>
        <article class="info-card pillar-card">
          <span class="pillar-number">04</span>
          <h3>We Build the Platform We Implement</h3>
          <p>Thailand's only OCA member and certified ERPNext partner. We have contributed 120+ modules to the open-source community — meaning we don't just implement ERP, we help build it.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 1.5 SOLUTIONS OVERVIEW -->
  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Solutions</p>
        <h2>End-to-end open source ERP services</h2>
        <p>Every service is built on 100% open source foundations with full source code delivery and no vendor lock-in.</p>
      </header>
      <div class="cards-grid cards-grid-3">
        <article class="info-card solution-card">
          <div class="solution-card-icon">🏭</div>
          <h3>ERP Implementation (Odoo)</h3>
          <p>Enterprise-grade ERP built on Odoo Community Edition with OCA-certified modules and full Thai localisation.</p>
          <a href="/solutions/erp-odoo" class="card-link">Learn more →</a>
        </article>
        <article class="info-card solution-card">
          <div class="solution-card-icon">⚙️</div>
          <h3>ERP Implementation (ERPNext)</h3>
          <p>100% open-source ERP on the Frappe Framework — ideal for manufacturing SMEs and tech companies.</p>
          <a href="/solutions/erp-erpnext" class="card-link">Learn more →</a>
        </article>
        <article class="info-card solution-card">
          <div class="solution-card-icon">🏛️</div>
          <h3>Government ERP</h3>
          <p>Purpose-built modules for Thai public-sector compliance: procurement, budget control, and fund accounting.</p>
          <a href="/solutions/government-erp" class="card-link">Learn more →</a>
        </article>
        <article class="info-card solution-card">
          <div class="solution-card-icon">📊</div>
          <h3>Business Intelligence Dashboard</h3>
          <p>Open source BI powered by Frappe Insights — connect your data and visualise KPIs in real time.</p>
          <a href="/solutions/bi-dashboard" class="card-link">Learn more →</a>
        </article>
        <article class="info-card solution-card">
          <div class="solution-card-icon">🔄</div>
          <h3>Process Automation (n8n)</h3>
          <p>Connect systems and eliminate manual hand-offs using n8n — self-hosted, open source, fully under your control.</p>
          <a href="/solutions/automation" class="card-link">Learn more →</a>
        </article>
        <article class="info-card solution-card">
          <div class="solution-card-icon">🧩</div>
          <h3>Other Frappe Solutions</h3>
          <p>CRM, HR, Helpdesk, LMS, Projects, and Healthcare — a complete ecosystem of open-source business apps.</p>
          <a href="/solutions/frappe-apps" class="card-link">Learn more →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- 1.6 INDUSTRIES -->
  <section class="section section-alt">
    <div class="container" style="text-align: center;">
      <p class="eyebrow eyebrow-centered">Industries We Serve</p>
      <h2 style="font-size: 1.7rem; letter-spacing: -0.03em; margin: 0 0 0.5rem;">We know your industry — not just your software</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 0;">
        Deep domain expertise across Thailand's key sectors.
      </p>
      <div class="industry-pills">
        <a href="/industries/manufacturing" class="industry-pill">🏭 Manufacturing</a>
        <a href="/industries/government" class="industry-pill">🏛️ Government &amp; NGO</a>
        <a href="/industries/trading" class="industry-pill">🛒 Trading &amp; Retail</a>
        <a href="/industries/professional-services" class="industry-pill">💼 Professional Services</a>
        <a href="/industries/technology" class="industry-pill">💻 Technology &amp; R&amp;D</a>
        <a href="/industries/healthcare" class="industry-pill">🏥 Healthcare</a>
      </div>
    </div>
  </section>

  <!-- 1.8 CLIENT LOGO WALL -->
  <section class="section section-logos">
    <div class="container">
      <p class="eyebrow eyebrow-centered">Trusted by leading Thai organisations across public and private sectors</p>
      <div class="logos-grid">
        {["nstda","biotec","nxpo","hii","bdi","cmo","cft","aal","acm","easy","esb","fofo","hwf","mcic","mh","monta","optima","rex","rjc","shm","sqp","thaiev","tti","usp","aab","skyviv","rje","jv_control","lpp"].map((logo) => (
          <div class="logo-item">
            <img src={`/images/cust_logo/${logo}.png`} alt={logo.toUpperCase()} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 1.10 BOTTOM CTA STRIP -->
  <section class="cta-strip">
    <div class="container cta-strip-grid">
      <div class="cta-strip-item">
        <h3>Ready to modernise your ERP?</h3>
        <p>Book a free consultation with one of our consultants. No sales pitch — just an honest conversation about your business.</p>
        <a href="/contact" class="btn btn-white">Book a Free Consultation</a>
      </div>
      <div class="cta-strip-item">
        <h3>Not sure where to start?</h3>
        <p>Answer 5 questions and get a personalised ERP readiness score with specific recommendations for your organisation.</p>
        <a href="/erp-readiness-assessment" class="btn btn-teal-outline">Take the Free ERP Readiness Assessment →</a>
      </div>
    </div>
  </section>

<script is:inline>
(function () {
  var canvas = document.getElementById('hero-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var particles = [];
  var MAX_DIST = 150;
  var COUNT = 45;

  function resize() {
    var hero = canvas.parentElement;
    canvas.width = hero.offsetWidth;
    canvas.height = hero.offsetHeight;
  }

  function randomBetween(a, b) {
    return a + Math.random() * (b - a);
  }

  function initParticles() {
    particles = [];
    for (var i = 0; i < COUNT; i++) {
      var large = Math.random() < 0.25;
      particles.push({
        x: randomBetween(0, canvas.width),
        y: randomBetween(0, canvas.height),
        vx: randomBetween(-0.3, 0.3),
        vy: randomBetween(-0.3, 0.3),
        r: large ? randomBetween(4, 7) : randomBetween(2, 4),
        color: large ? '#76abae' : '#5a9094'
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Draw lines
    for (var i = 0; i < particles.length; i++) {
      for (var j = i + 1; j < particles.length; j++) {
        var dx = particles[i].x - particles[j].x;
        var dy = particles[i].y - particles[j].y;
        var dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < MAX_DIST) {
          var alpha = (1 - dist / MAX_DIST) * 0.4;
          ctx.beginPath();
          ctx.strokeStyle = 'rgba(118, 171, 174, ' + alpha + ')';
          ctx.lineWidth = 1;
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.stroke();
        }
      }
    }

    // Draw dots
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = p.color;
      ctx.globalAlpha = 0.85;
      ctx.fill();
      ctx.globalAlpha = 1;
    }
  }

  function update() {
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0) { p.x = 0; p.vx *= -1; }
      if (p.x > canvas.width) { p.x = canvas.width; p.vx *= -1; }
      if (p.y < 0) { p.y = 0; p.vy *= -1; }
      if (p.y > canvas.height) { p.y = canvas.height; p.vy *= -1; }
    }
  }

  function loop() {
    update();
    draw();
    requestAnimationFrame(loop);
  }

  resize();
  initParticles();
  loop();

  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      resize();
    }, 100);
  });
})();
</script>

</BaseLayout>
