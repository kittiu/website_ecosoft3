---
import BaseLayout from "@layouts/BaseLayout.astro";

const supportPlans = [
  {
    name: "Essential",
    description: "สำหรับระบบที่เสถียรและต้องการความช่วยเหลือเป็นครั้งคราว",
    includes: [
      "รองรับทางอีเมล (ในเวลาทำการ)",
      "ตรวจสอบและแก้ไขข้อผิดพลาด",
      "ปรับแต่งการตั้งค่าเล็กน้อย",
      "ติดตามสถานภาพระบบ",
      "ทบทวน version รายปี",
    ],
    responseTime: "2 วันทำการ",
    suitable: "ระบบที่ใช้งานจริงที่มีปริมาณการเปลี่ยนแปลงน้อย",
  },
  {
    name: "Standard",
    description: "สำหรับระบบที่พัฒนาต่อเนื่องและมีคำขอเปลี่ยนแปลงสม่ำเสมอ",
    includes: [
      "รองรับทางอีเมลและโทรศัพท์ (ในเวลาทำการ)",
      "ตรวจสอบและแก้ไขข้อผิดพลาด",
      "ปรับแต่งการตั้งค่าและอัปเดตโมดูล",
      "ชั่วโมงพัฒนาระบบตามกำหนดต่อเดือน",
      "การประชุมรีวิวรายไตรมาส",
      "ติดตามสถานภาพระบบ",
    ],
    responseTime: "1 วันทำการ",
    suitable: "ธุรกิจที่กำลังขยายโมดูลหรือผู้ใช้งาน",
    highlighted: true,
  },
  {
    name: "Priority",
    description: "สำหรับระบบที่มีความสำคัญสูงและไม่สามารถหยุดทำงานได้",
    includes: [
      "รองรับทางอีเมล โทรศัพท์ และ LINE",
      "ครอบคลุมนอกเวลาทำการ",
      "ตอบสนองภายในวันเดียวกันสำหรับปัญหาวิกฤต",
      "ชั่วโมงพัฒนาระบบรายเดือนรวมอยู่ในแผน",
      "การประชุมรีวิวรายเดือน",
      "การติดตามและแจ้งเตือนเชิงรุก",
      "ที่ปรึกษาประจำบัญชีโดยเฉพาะ",
    ],
    responseTime: "ภายในวันเดียวกัน (ปัญหาวิกฤต: 4 ชั่วโมง)",
    suitable: "ระบบองค์กรขนาดใหญ่และหน่วยงานภาครัฐ",
  },
];
---

<BaseLayout
  title="แผนบริการหลังการติดตั้ง | Ecosoft"
  description="สัญญาสนับสนุนรายปีสำหรับระบบ Odoo และ ERPNext — ครอบคลุมการแก้ไขข้อผิดพลาด ปรับแต่งการตั้งค่า ติดตามระบบ และการพัฒนาต่อเนื่อง"
>

  <!-- HERO -->
  <section class="hero" style="padding-bottom:2rem;">
    <div class="container">
      <p class="eyebrow">หลัง Go-Live</p>
      <h1>ERP systems need tending. We handle that.</h1>
      <p class="hero-lead">
        การติดตั้ง ERP ไม่ใช่งานที่ทำครั้งเดียวแล้วจบ เมื่อธุรกิจของคุณเติบโต ระบบก็ต้องพัฒนาตามไปด้วย
        สัญญาสนับสนุนของ Ecosoft ช่วยให้ระบบของคุณทำงานได้อย่างมีประสิทธิภาพ —
        และมั่นใจได้ว่าคุณจะได้รับความช่วยเหลือจากผู้เชี่ยวชาญเมื่อต้องการ
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-primary">พูดคุยเรื่องบริการสนับสนุน</a>
        <a href="/solutions/pricing" class="btn btn-outline">ดูราคา</a>
      </div>
    </div>
  </section>

  <!-- SUPPORT PLANS -->
  <section class="section">
    <div class="container">
      <h2 style="text-align:center;">แผนบริการสนับสนุน</h2>
      <p class="section-lead" style="text-align:center;">สัญญารายปีครอบคลุมความต้องการด้านการสนับสนุนหลังการติดตั้งอย่างครบถ้วน</p>
      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:1.5rem; margin-top:2.5rem;">
        {supportPlans.map((plan) => (
          <div class="info-card" style={`padding:2rem; ${plan.highlighted ? 'border:2px solid var(--accent);' : ''}`}>
            {plan.highlighted && (
              <div style="text-align:center; margin-bottom:1rem;">
                <span class="tag" style="background:var(--accent);color:#fff;">ยอดนิยม</span>
              </div>
            )}
            <h3 style="margin-top:0;">{plan.name}</h3>
            <p style="color:var(--text-muted); font-size:0.875rem; margin-bottom:1.5rem;">{plan.description}</p>
            <div style="font-size:0.8125rem; color:var(--text-muted); margin-bottom:1.25rem;">
              <strong style="color:var(--text);">เวลาตอบสนอง:</strong> {plan.responseTime}
            </div>
            <ul style="list-style:none; padding:0; margin:0 0 1.5rem; display:flex; flex-direction:column; gap:0.5rem;">
              {plan.includes.map((item) => (
                <li style="font-size:0.875rem; display:flex; gap:0.5rem; align-items:flex-start;">
                  <span style="color:var(--accent); flex-shrink:0;">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p style="font-size:0.8125rem; color:var(--text-muted); margin-bottom:1.25rem;">
              <strong style="color:var(--text);">เหมาะสำหรับ:</strong> {plan.suitable}
            </p>
            <a href="/contact" class="btn btn-outline" style="width:100%; text-align:center; display:block;">ขอใบเสนอราคา →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT SUPPORT COVERS -->
  <section class="section" style="background: var(--surface);">
    <div class="container">
      <h2 style="text-align:center;">ขอบเขตของบริการสนับสนุน</h2>
      <p class="section-lead" style="text-align:center;">คำอธิบายชัดเจนว่าสิ่งใดอยู่ในขอบเขต — และสิ่งใดต้องดำเนินการเป็นโปรเจกต์แยก</p>
      <div class="cards-grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:1.5rem; margin-top:2.5rem;">
        <div class="info-card">
          <h4>✓ ครอบคลุมโดยบริการสนับสนุน</h4>
          <ul style="list-style:none; padding:0; display:flex; flex-direction:column; gap:0.4rem; font-size:0.875rem;">
            <li>แก้ไขข้อผิดพลาด — ระบบทำงานไม่ตรงตามที่ตั้งค่าไว้</li>
            <li>ปรับแต่งการตั้งค่า — ปรับการกำหนดค่าที่มีอยู่</li>
            <li>จัดการสิทธิ์การเข้าถึงของผู้ใช้</li>
            <li>แก้ไขรายงานเล็กน้อย</li>
            <li>ติดตามระบบและแจ้งเตือน</li>
            <li>คำแนะนำการใช้งานฟังก์ชันที่มีอยู่</li>
          </ul>
        </div>
        <div class="info-card">
          <h4>⚡ ดำเนินการผ่านชั่วโมงพัฒนาระบบ</h4>
          <ul style="list-style:none; padding:0; display:flex; flex-direction:column; gap:0.4rem; font-size:0.875rem;">
            <li>การติดตั้งโมดูลใหม่</li>
            <li>การพัฒนาโมดูลแบบกำหนดเอง</li>
            <li>การเปลี่ยนแปลง workflow ขนาดใหญ่</li>
            <li>การพัฒนารายงานหรือ dashboard ใหม่</li>
            <li>การเชื่อมต่อระบบภายนอก</li>
            <li>การอัปเกรด version</li>
          </ul>
        </div>
        <div class="info-card">
          <h4>📋 เชิงรุก (Standard / Priority)</h4>
          <ul style="list-style:none; padding:0; display:flex; flex-direction:column; gap:0.4rem; font-size:0.875rem;">
            <li>การประชุมรีวิวตามกำหนด</li>
            <li>ตรวจสอบประสิทธิภาพระบบ</li>
            <li>บันทึก release ใหม่และการประเมินผลกระทบ</li>
            <li>รวบรวม feedback จากผู้ใช้</li>
            <li>วางแผน roadmap การพัฒนา</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CURRENT CLIENTS -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <h2>ความร่วมมือระยะยาว</h2>
      <p class="section-lead" style="max-width:640px; margin:0 auto;">
        ความสัมพันธ์ที่ยาวนานที่สุดของ Ecosoft กับลูกค้ามากกว่า 10 ปี ซึ่งไม่ได้เกิดขึ้นโดยบังเอิญ —
        แต่เป็นผลจากโมเดลสนับสนุนที่เน้นรักษาระบบให้ทำงานได้ดี ไม่ใช่การสร้าง ticket ปริมาณมาก
      </p>
      <div style="display:flex; gap:2rem; justify-content:center; flex-wrap:wrap; margin-top:2.5rem;">
        <div style="text-align:center;">
          <div style="font-size:2.5rem; font-weight:700; color:var(--accent);">10+</div>
          <div style="font-size:0.875rem; color:var(--text-muted);">ปี กับ Raja Cycle</div>
        </div>
        <div style="text-align:center;">
          <div style="font-size:2.5rem; font-weight:700; color:var(--accent);">7+</div>
          <div style="font-size:0.875rem; color:var(--text-muted);">ปี กับ NSTDA</div>
        </div>
        <div style="text-align:center;">
          <div style="font-size:2.5rem; font-weight:700; color:var(--accent);">10+</div>
          <div style="font-size:0.875rem; color:var(--text-muted);">ปี กับ Square Panel Systems</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container">
      <h2>ต้องการบริการสนับสนุนสำหรับระบบ Odoo หรือ ERPNext ที่มีอยู่แล้วหรือไม่?</h2>
      <p>พูดคุยกับเรา — แม้เราไม่ใช่ผู้ติดตั้งระบบให้คุณตั้งแต่แรก เราก็สามารถรับช่วงต่อและดูแลให้ระบบมีเสถียรภาพได้</p>
      <a href="/contact" class="btn btn-primary">ขอใบเสนอราคาบริการสนับสนุน</a>
    </div>
  </section>

</BaseLayout>
