---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="ERP for Thai Government Agencies | Ecosoft"
  description="Ecosoft implements Odoo for Thai government agencies — budget encumbrance, government procurement compliance, multi-fund accounting, and audit-ready reporting."
>


  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Industry — Government</p>
      <h1>Open-source ERP for Thai government agencies. Running in production since 2018.</h1>
      <p class="hero-lead">
        Ecosoft has implemented Odoo for multiple Thai government agencies — replacing SAP, replacing proprietary systems,
        and building purpose-built modules for Thai public sector compliance. Our reference installation at NSTDA
        has been running continuously since 2018.
      </p>
      <div class="hero-actions">
        <a href="/solutions/government-erp" class="btn btn-primary">Explore Government ERP</a>
        <a href="/case-studies/nstda" class="btn btn-outline">NSTDA Case Study</a>
      </div>
    </div>
  </section>

  <!-- UNIQUE NEEDS -->
  <section class="section" style="background: var(--surface);">
    <div class="container">
      <h2 style="text-align:center;">What makes government ERP different</h2>
      <div class="cards-grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:1.5rem; margin-top:2.5rem;">
        <div class="info-card">
          <h4>Budget encumbrance control</h4>
          <p>Government agencies must prevent over-commitment before it happens — not report over-spending after. Hard budget controls at the point of PO creation.</p>
        </div>
        <div class="info-card">
          <h4>Government procurement compliance</h4>
          <p>Thai government procurement regulations mandate specific workflows, quotation thresholds, and committee approvals that standard purchase modules don't handle.</p>
        </div>
        <div class="info-card">
          <h4>Multi-fund accounting</h4>
          <p>Research agencies and departments track spending by programme, project, and funding source — not just by department code.</p>
        </div>
        <div class="info-card">
          <h4>Public audit requirements</h4>
          <p>Every transaction must be auditable — complete trail from budget allocation to final payment, with segregation of duties enforced by the system.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GOVERNMENT MODULES -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <h2>Purpose-built for Thai public sector</h2>
      <p class="section-lead">All modules released as open-source — no proprietary lock-in for a public institution.</p>
      <div style="margin-top:2rem;">
        <a href="/solutions/government-erp" class="btn btn-primary">See Full Government ERP Modules</a>
      </div>
    </div>
  </section>

  <!-- CLIENTS -->
  <section class="section" style="background: var(--surface);">
    <div class="container">
      <h2 style="text-align:center;">Government clients</h2>
      <div class="cards-grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap:1.5rem; margin-top:2rem;">
        <div class="case-study-card">
          <div class="case-study-card-tags">
            <span class="tag">Odoo</span><span class="tag tag--industry">Government</span>
          </div>
          <h3>NSTDA</h3>
          <p>National Science and Technology Development Agency. Replaced SAP in 2018. 7+ years of continuous operation across multiple research centres.</p>
          <a href="/case-studies/nstda" class="btn btn-outline">Read case study →</a>
        </div>
        <div class="case-study-card">
          <div class="case-study-card-tags">
            <span class="tag">Odoo</span><span class="tag tag--industry">Government</span>
          </div>
          <h3>NXPO</h3>
          <p>National Higher Education, Science, Research and Innovation Policy Council. Government ERP with policy programme budgeting.</p>
          <a href="/case-studies" class="btn btn-outline">More case studies →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container">
      <h2>Running a Thai government agency or public institution?</h2>
      <p>Talk to our government ERP team — we'll show you our reference installation and assess fit for your organisation.</p>
      <a href="/contact" class="btn btn-primary">Request a Government ERP Consultation</a>
    </div>
  </section>

</BaseLayout>
