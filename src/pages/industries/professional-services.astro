---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="ERP for Professional Services | Ecosoft"
  description="Ecosoft implements Odoo and ERPNext for professional services firms — project-based billing, timesheet management, resource allocation, and Thai accounting compliance."
>


  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Industry — Professional Services</p>
      <h1>Project-based ERP for consulting, engineering, and services firms.</h1>
      <p class="hero-lead">
        Professional services businesses don't run on inventory — they run on people, projects, and time.
        Ecosoft implements Odoo and ERPNext for consulting firms, engineering companies, and services businesses
        that need project-based billing, resource allocation, and profitability tracking — integrated with Thai accounting.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-primary">Book a Professional Services ERP Consultation</a>
        <a href="/case-studies/eos-orbit" class="btn btn-outline">See EOS Orbit Case Study</a>
      </div>
    </div>
  </section>

  <!-- KEY NEEDS -->
  <section class="section" style="background: var(--surface);">
    <div class="container">
      <h2 style="text-align:center;">What professional services firms need from ERP</h2>
      <div class="cards-grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:1.5rem; margin-top:2.5rem;">
        <div class="info-card">
          <div class="info-card-icon">📋</div>
          <h4>Project management</h4>
          <p>Project phases, task tracking, milestone billing, and budget-vs-actual visibility — connected to the same system managing invoicing and payroll.</p>
        </div>
        <div class="info-card">
          <div class="info-card-icon">⏱️</div>
          <h4>Timesheet & billing</h4>
          <p>Staff time tracked against projects, with billing rates by role and project type — flowing directly to client invoices without manual reconciliation.</p>
        </div>
        <div class="info-card">
          <div class="info-card-icon">👥</div>
          <h4>Resource allocation</h4>
          <p>Visibility into who is allocated where, utilisation rates, and capacity planning — so you can take on new work without overloading your team.</p>
        </div>
        <div class="info-card">
          <div class="info-card-icon">📊</div>
          <h4>Project profitability</h4>
          <p>Real margin per project — revenue, staff cost, subcontractor cost, and overhead fully captured and reportable by project, client, or service line.</p>
        </div>
        <div class="info-card">
          <div class="info-card-icon">📑</div>
          <h4>Contract & milestone billing</h4>
          <p>Milestone-based billing schedules, retainer management, and contract tracking — so revenue recognition aligns with delivery.</p>
        </div>
        <div class="info-card">
          <div class="info-card-icon">💰</div>
          <h4>Thai accounting</h4>
          <p>VAT on services, withholding tax (WHT) on professional fees, and Thai-compliant financial reporting — built in, not bolted on.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container">
      <h2>Running a consulting, engineering, or services firm in Thailand?</h2>
      <p>Talk to us about project-based ERP — we'll show you how the system supports the way services businesses actually work.</p>
      <a href="/contact" class="btn btn-primary">Book a Free Consultation</a>
    </div>
  </section>

</BaseLayout>
