---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="ERP for Trading & Distribution | Ecosoft"
  description="Ecosoft implements Odoo and ERPNext for Thai trading and distribution businesses — multi-warehouse inventory, purchase-to-pay, order-to-cash, and Thai accounting compliance."
>


  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Industry — Trading & Distribution</p>
      <h1>Full purchase-to-pay and order-to-cash. Without the enterprise price tag.</h1>
      <p class="hero-lead">
        Trading businesses need fast, accurate stock management, supplier management, and customer order processing —
        with Thai accounting compliance built in. Ecosoft implements Odoo and ERPNext for distributors and trading companies
        that have outgrown accounting software but don't need enterprise complexity.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-primary">Book a Trading ERP Consultation</a>
        <a href="/solutions/erp-odoo" class="btn btn-outline">Explore Odoo for Trading</a>
      </div>
    </div>
  </section>

  <!-- MODULES -->
  <section class="section" style="background: var(--surface);">
    <div class="container">
      <h2 style="text-align:center;">What a trading ERP implementation covers</h2>
      <div class="cards-grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:1.5rem; margin-top:2.5rem;">
        <div class="info-card">
          <div class="info-card-icon">📦</div>
          <h4>Multi-warehouse inventory</h4>
          <p>Stock across multiple locations, transfer orders, real-time stock levels, FIFO/AVCO costing, and reorder rules that trigger purchase recommendations automatically.</p>
        </div>
        <div class="info-card">
          <div class="info-card-icon">🛒</div>
          <h4>Purchase-to-pay</h4>
          <p>Supplier management, RFQ, purchase orders, goods receipt, 3-way matching, and supplier invoicing — with landed cost allocation for imported goods.</p>
        </div>
        <div class="info-card">
          <div class="info-card-icon">📋</div>
          <h4>Order-to-cash</h4>
          <p>Quotations, sales orders, delivery notes, and customer invoicing — with customer credit limit management and overdue tracking built in.</p>
        </div>
        <div class="info-card">
          <div class="info-card-icon">🚚</div>
          <h4>Logistics coordination</h4>
          <p>Delivery scheduling, carrier management, shipping documentation, and real-time delivery status — connected to your inventory and invoicing processes.</p>
        </div>
        <div class="info-card">
          <div class="info-card-icon">💰</div>
          <h4>Thai accounting</h4>
          <p>VAT, withholding tax, Thai chart of accounts, bank reconciliation, and financial reporting — compliant with Revenue Department requirements.</p>
        </div>
        <div class="info-card">
          <div class="info-card-icon">📊</div>
          <h4>Sales analytics</h4>
          <p>Product performance, customer profitability, supplier lead time analysis, and inventory turnover — visible in real time, not in next week's spreadsheet.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY OPEN SOURCE -->
  <section class="section">
    <div class="container">
      <div style="max-width:760px; margin:0 auto; text-align:center;">
        <h2>Why trading companies choose open-source ERP</h2>
        <p class="section-lead">
          Per-user licence costs punish growth. When your team expands from 10 to 50 people,
          your ERP cost shouldn't multiply five-fold. Odoo Community Edition and ERPNext are free —
          you pay for implementation and support, not for the right to use the software.
        </p>
        <a href="/why-ecosoft/why-open-source" class="btn btn-outline" style="margin-top:1.5rem;">Why open source matters →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container">
      <h2>Running a trading or distribution business in Thailand?</h2>
      <p>Tell us about your current system and the biggest gap. We'll recommend the right platform and scope.</p>
      <a href="/contact" class="btn btn-primary">Book a Free Consultation</a>
    </div>
  </section>

</BaseLayout>
