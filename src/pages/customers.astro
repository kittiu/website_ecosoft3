---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allCaseStudies = await getCollection("case-studies");
const sorted = allCaseStudies.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.client.localeCompare(b.data.client);
});
---

<BaseLayout
  title="ลูกค้าของเรา | Ecosoft"
  description="ลูกค้า Ecosoft ในกลุ่มการผลิต ภาครัฐ และเทคโนโลยี ได้แก่ Raja Cycle, NSTDA, EOS Orbit, Lamphun Plastpack และ Square Panel Systems"
>

  <!-- HERO -->
  <section class="hero" style="padding-bottom:2rem;">
    <div class="container">
      <p class="eyebrow">ลูกค้าของเรา</p>
      <h1>Businesses that have trusted Ecosoft with their ERP.</h1>
      <p class="hero-lead">
        จากผู้ผลิตดาวเทียมรายแรกของไทยสู่โรงงานผลิตจักรยานที่ใช้ Odoo มากว่าสิบปี —
        ทุกรายชื่อที่นี่คือระบบที่ใช้งานจริงในการผลิต ไม่ใช่การทดลองนำร่อง
      </p>
      <div class="hero-actions">
        <a href="/case-studies" class="btn btn-primary">ดู Case Studies</a>
        <a href="/case-studies/video-testimonials" class="btn btn-outline">ชมวิดีโอรีวิวจากลูกค้า</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section style="background: var(--surface); padding:2.5rem 0; border-bottom:1px solid var(--border);">
    <div class="container">
      <div style="display:flex; gap:3rem; justify-content:center; flex-wrap:wrap; text-align:center;">
        <div>
          <div style="font-size:2.5rem; font-weight:700; color:var(--accent);">10+</div>
          <div style="font-size:0.875rem; color:var(--text-muted);">ปี ความร่วมมือที่ยาวนานที่สุด</div>
        </div>
        <div>
          <div style="font-size:2.5rem; font-weight:700; color:var(--accent);">50+</div>
          <div style="font-size:0.875rem; color:var(--text-muted);">ลูกค้าที่ติดตั้งระบบแล้ว</div>
        </div>
        <div>
          <div style="font-size:2.5rem; font-weight:700; color:var(--accent);">2</div>
          <div style="font-size:0.875rem; color:var(--text-muted);">แพลตฟอร์ม (Odoo + ERPNext)</div>
        </div>
        <div>
          <div style="font-size:2.5rem; font-weight:700; color:var(--accent);">4+</div>
          <div style="font-size:0.875rem; color:var(--text-muted);">อุตสาหกรรมที่ให้บริการ</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED CLIENTS -->
  <section class="section">
    <div class="container">
      <h2>ลูกค้าเด่น</h2>
      <div class="case-studies-grid" style="margin-top:2rem;">
        {sorted.filter(cs => cs.data.featured).map((cs) => (
          <div class="case-study-card" style="border-top:3px solid var(--accent);">
            <div class="case-study-card-tags">
              <span class="tag">{cs.data.solution}</span>
              <span class="tag tag--industry">{cs.data.industry}</span>
            </div>
            <h3>{cs.data.client}</h3>
            <p style="font-size:0.875rem; color:var(--text-muted); margin-bottom:0.75rem;">{cs.data.location} · {cs.data.size}</p>
            <blockquote style="border-left:3px solid var(--border); padding-left:1rem; margin:0.75rem 0; font-style:italic; font-size:0.9rem; color:var(--text-muted);">
              "{cs.data.quote.substring(0, 160)}{cs.data.quote.length > 160 ? '…' : ''}"
            </blockquote>
            <p style="font-size:0.8rem; color:var(--text-muted); margin-bottom:1rem;">— {cs.data.quoteAuthor}</p>
            <a href={`/case-studies/${cs.id}`} class="btn btn-outline">อ่าน Case Study →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ALL CLIENTS -->
  <section class="section" style="background: var(--surface);">
    <div class="container">
      <h2>ลูกค้าทั้งหมด</h2>
      <div class="case-studies-grid" style="margin-top:2rem;">
        {sorted.filter(cs => !cs.data.featured).map((cs) => (
          <div class="case-study-card">
            <div class="case-study-card-tags">
              <span class="tag">{cs.data.solution}</span>
              <span class="tag tag--industry">{cs.data.industry}</span>
            </div>
            <h3>{cs.data.client}</h3>
            <p style="font-size:0.875rem; color:var(--text-muted); margin-bottom:0.75rem;">{cs.data.location} · {cs.data.size}</p>
            <p style="font-size:0.9rem;">{cs.data.outcome}</p>
            <a href={`/case-studies/${cs.id}`} class="btn btn-outline" style="margin-top:1rem;">อ่าน Case Study →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <h2>อุตสาหกรรมที่เราให้บริการ</h2>
      <p class="section-lead">Open Source ERP สำหรับภาคธุรกิจสำคัญทั่วประเทศไทย</p>
      <div class="industry-pills" style="justify-content:center; margin-top:2rem;">
        <a href="/industries/manufacturing" class="industry-pill">Manufacturing</a>
        <a href="/industries/government" class="industry-pill">Government</a>
        <a href="/industries/trading" class="industry-pill">Trading</a>
        <a href="/industries/professional-services" class="industry-pill">Professional Services</a>
        <a href="/industries/technology" class="industry-pill">Technology</a>
        <a href="/industries/healthcare" class="industry-pill">Healthcare</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container">
      <h2>พร้อมที่จะเป็นส่วนหนึ่งของรายชื่อนี้แล้วหรือยัง?</h2>
      <p>บอกเราเกี่ยวกับความท้าทาย ERP ของคุณ — เราจะให้ความเห็นตรงๆ ว่า Open Source ERP เหมาะกับธุรกิจของคุณหรือไม่</p>
      <a href="/contact" class="btn btn-primary">จองการปรึกษาฟรี</a>
    </div>
  </section>

</BaseLayout>
