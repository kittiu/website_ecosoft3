---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="ERP Implementation — ERPNext | Ecosoft"
  description="Ecosoft is a certified ERPNext partner and active contributor to the Frappe codebase. 100% open-source ERP with no licence fees and full source code ownership."
>


  <!-- HERO -->
  <section class="hero hero--erpnext">
    <div class="container">
      <div class="erpnext-hero-inner">
        <div>
          <p class="eyebrow">ERP Implementation</p>
          <h1>The 100% open-source ERP for growing businesses that want to own their own destiny.</h1>
          <p class="hero-lead">
            ERPNext is a fully open-source ERP built on the Frappe Framework. With no licence cost,
            a clean modern interface, and a global community of contributors, it is particularly
            well-suited to manufacturing SMEs, technology companies, and organisations that want
            deep customisability without vendor dependency.
          </p>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
            Ecosoft is a certified ERPNext partner and an active contributor to the ERPNext and
            Frappe codebase — meaning our team knows the platform from the inside out.
          </p>
          <div class="hero-actions">
            <a href="/case-studies" class="btn btn-primary">See ERPNext Case Studies</a>
            <a href="/contact" class="btn btn-outline">Book a Free ERPNext Consultation</a>
          </div>
        </div>
        <div class="product-hero-card">
          <img src="/images/erpnext-logo.png" alt="ERPNext" class="product-hero-card-logo" />
          <div class="product-hero-card-stats">
            <div class="product-hero-stat">
              <span class="product-hero-stat-number">1M+</span>
              <span class="product-hero-stat-label">Active users worldwide</span>
            </div>
            <div class="product-hero-stat">
              <span class="product-hero-stat-number">130+</span>
              <span class="product-hero-stat-label">Ready integrations</span>
            </div>
            <div class="product-hero-stat">
              <span class="product-hero-stat-number">฿0</span>
              <span class="product-hero-stat-label">Software licence cost</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CORE MODULES -->
  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Core Modules</p>
        <h2>Everything your business needs — in one open-source platform</h2>
        <p>ERPNext covers all core business functions with a clean, modern interface and no licence cost.</p>
      </header>
      <div class="cards-grid">
        <article class="info-card">
          <h3>💰 Accounting</h3>
          <p>Multi-currency, tax templates, financial statements, Thai payroll compliance, and withholding tax.</p>
        </article>
        <article class="info-card">
          <h3>📦 Stock &amp; Inventory</h3>
          <p>Item variants, batch tracking, quality inspection, serial number tracking, and multiple warehouses.</p>
        </article>
        <article class="info-card">
          <h3>🏭 Manufacturing</h3>
          <p>BOM management, work orders, job cards, capacity planning, and production costing.</p>
        </article>
        <article class="info-card">
          <h3>🛒 Buying &amp; Selling</h3>
          <p>Complete procurement and sales workflows — RFQ, PO, GRN, quotations, delivery, and invoicing.</p>
        </article>
        <article class="info-card">
          <h3>👥 HR &amp; Payroll</h3>
          <p>Attendance, leave management, Thai payroll compliance, social security, and employee self-service.</p>
        </article>
        <article class="info-card">
          <h3>📋 Project Management</h3>
          <p>Timesheets, task tracking, project billing, Gantt charts, and resource allocation.</p>
        </article>
        <article class="info-card">
          <h3>🤝 CRM</h3>
          <p>Leads, opportunities, customer portal, and sales pipeline management.</p>
        </article>
        <article class="info-card">
          <h3>🔧 Custom Development</h3>
          <p>All customisations built on the Frappe Framework — maintainable, upgradeable, and fully open source.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ERPNEXT VS ODOO -->
  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">ERPNext vs Odoo</p>
        <h2>Which is right for you?</h2>
        <p>
          Both platforms are excellent. The right choice depends on your industry, team size, and IT
          capabilities. Ecosoft implements both and has no commercial incentive to recommend one over
          the other — we'll give you an honest recommendation based on your business.
        </p>
      </header>
      <table class="pricing-table" style="margin-top: 1rem;">
        <thead>
          <tr>
            <th>Factor</th>
            <th>ERPNext</th>
            <th class="col-featured">Odoo (CE + OCA)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Licence Cost</strong></td>
            <td>฿0 — 100% open source</td>
            <td>฿0 — Community Edition</td>
          </tr>
          <tr>
            <td><strong>UI Maturity</strong></td>
            <td>Clean, modern, developer-friendly</td>
            <td>Polished, business-user-focused</td>
          </tr>
          <tr>
            <td><strong>Manufacturing</strong></td>
            <td>Excellent — BOM, job cards, capacity</td>
            <td>Strong — MRP, variants, work centres</td>
          </tr>
          <tr>
            <td><strong>Thai Localisation</strong></td>
            <td>Good — Ecosoft contributes modules</td>
            <td>Excellent — 50+ OCA Thai modules</td>
          </tr>
          <tr>
            <td><strong>Best For</strong></td>
            <td>Manufacturing SMEs, tech companies</td>
            <td>Trading, services, government, large orgs</td>
          </tr>
          <tr>
            <td><strong>Community</strong></td>
            <td>Global Frappe / ERPNext community</td>
            <td>OCA — largest open-source ERP community</td>
          </tr>
        </tbody>
      </table>
      <div style="margin-top: 1.5rem;">
        <a href="/resources/odoo-vs-erpnext" class="btn btn-outline">Full Comparison Guide →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container cta-strip-grid">
      <div class="cta-strip-item">
        <h3>See ERPNext running your business</h3>
        <p>Book a free 45-minute live demo focused on your industry and processes.</p>
        <a href="/book-demo" class="btn btn-white">Book a Free Demo</a>
      </div>
      <div class="cta-strip-item">
        <h3>Not sure which platform to choose?</h3>
        <p>Our consultants will give you an honest recommendation. No sales pressure — just the right fit for your business.</p>
        <a href="/contact" class="btn btn-teal-outline">Talk to a Consultant →</a>
      </div>
    </div>
  </section>

</BaseLayout>
