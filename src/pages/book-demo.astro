---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Book a Demo | Ecosoft"
  description="See your business processes running in a real ERP — live, with one of our consultants. Choose a 45-min overview or 90-min deep-dive tailored to your industry."
>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Book a Demo</p>
        <h1>See your business processes in a real ERP — live, with one of our consultants.</h1>
        <p class="hero-lead">
          We don't do canned presentations. Every demo is tailored to your business: your
          industry, your processes, your pain points. That's why we ask for a short 15-minute
          pre-call first — so we show you what actually matters to you.
        </p>
        <div class="hero-metas">
          <div>
            <p class="metric-number">15 min</p>
            <p class="metric-label">pre-call to understand your needs</p>
          </div>
          <div>
            <p class="metric-number">45–90 min</p>
            <p class="metric-label">live tailored walkthrough</p>
          </div>
          <div>
            <p class="metric-number">48 hrs</p>
            <p class="metric-label">written summary follow-up</p>
          </div>
        </div>
      </div>
      <div class="hero-card">
        <div class="hero-card-main">
          <h2>What to expect</h2>
          <ul>
            <li>15-min pre-call to understand your business</li>
            <li>Live walkthrough of your actual use case</li>
            <li>Q&amp;A at every stage — no sales script</li>
            <li>Written summary within 48 hours</li>
            <li>No sales pressure or follow-up calls unless you ask</li>
          </ul>
        </div>
        <div class="hero-card-badges">
          <span>Free — no obligation</span>
          <span>Tailored to your industry</span>
        </div>
      </div>
    </div>
  </section>

  <!-- DEMO FORMAT -->
  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Choose Your Format</p>
        <h2>Two demo formats — pick what fits your schedule</h2>
      </header>
      <div class="cards-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
        <article class="info-card pillar-card">
          <span class="pillar-number">45</span>
          <h3>Overview Demo</h3>
          <p>
            A focused walkthrough of the modules most relevant to your business. Covers the core
            ERP flow — from purchase order through to financial reporting — with Q&amp;A throughout.
          </p>
          <p><strong>Best for:</strong> Decision-makers exploring ERP for the first time or comparing vendors.</p>
          <div style="margin-top: 1rem;">
            <a href="/contact" class="btn btn-primary">Book a 45-min Demo</a>
          </div>
        </article>
        <article class="info-card pillar-card">
          <span class="pillar-number">90</span>
          <h3>Deep-Dive Demo</h3>
          <p>
            An in-depth session covering your specific processes in detail. We configure a basic
            demo environment around your business type before the session.
          </p>
          <p><strong>Best for:</strong> IT leads, finance managers, and operations teams evaluating specific capabilities.</p>
          <div style="margin-top: 1rem;">
            <a href="/contact" class="btn btn-outline">Book a 90-min Demo</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- SCHEDULING -->
  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Schedule Your Demo</p>
        <h2>Request a demo time that works for you</h2>
        <p>
          Fill in the form below and our team will confirm a time within one business day.
          All demos are conducted via video call (Google Meet or Zoom).
        </p>
      </header>
      <div style="max-width: 36rem;">
        <form class="contact-form" id="demo-form" novalidate>
          <div class="form-row">
            <label for="demo-name">
              Full Name <span aria-hidden="true">*</span>
              <input id="demo-name" type="text" name="name" placeholder="Your full name" required />
            </label>
            <label for="demo-company">
              Company <span aria-hidden="true">*</span>
              <input id="demo-company" type="text" name="company" placeholder="Company name" required />
            </label>
          </div>
          <div class="form-row">
            <label for="demo-email">
              Email <span aria-hidden="true">*</span>
              <input id="demo-email" type="email" name="email" placeholder="you@company.com" required />
            </label>
            <label for="demo-phone">
              Phone
              <input id="demo-phone" type="tel" name="phone" placeholder="+66 ..." />
            </label>
          </div>
          <label for="demo-format">
            Demo Format <span aria-hidden="true">*</span>
            <select id="demo-format" name="format" required style="border-radius: 0.6rem; border: 1px solid var(--input-border); background: var(--input-bg); color: var(--text); padding: 0.55rem 0.7rem; font: inherit; width: 100%;">
              <option value="">Select...</option>
              <option>45-min Overview Demo</option>
              <option>90-min Deep-Dive Demo</option>
              <option>Not sure — recommend for me</option>
            </select>
          </label>
          <label for="demo-platform">
            ERP Platform Interest
            <select id="demo-platform" name="platform" style="border-radius: 0.6rem; border: 1px solid var(--input-border); background: var(--input-bg); color: var(--text); padding: 0.55rem 0.7rem; font: inherit; width: 100%;">
              <option value="">Select...</option>
              <option>Odoo</option>
              <option>ERPNext</option>
              <option>Not sure — recommend for me</option>
            </select>
          </label>
          <label for="demo-industry">
            Industry
            <select id="demo-industry" name="industry" style="border-radius: 0.6rem; border: 1px solid var(--input-border); background: var(--input-bg); color: var(--text); padding: 0.55rem 0.7rem; font: inherit; width: 100%;">
              <option value="">Select...</option>
              <option>Manufacturing</option>
              <option>Government / NGO</option>
              <option>Trading &amp; Retail</option>
              <option>Technology</option>
              <option>Professional Services</option>
              <option>Healthcare</option>
              <option>Other</option>
            </select>
          </label>
          <label for="demo-notes">
            Anything specific you'd like to see?
            <textarea id="demo-notes" name="notes" rows="3" placeholder="e.g. Thai payroll, production planning, government procurement..."></textarea>
          </label>
          <div id="demo-success" class="form-success" hidden>
            Request received! We'll confirm your demo time within one business day.
          </div>
          <button type="submit" class="btn btn-primary btn-full">Request Demo Time</button>
          <p class="form-note">
            We'll email you within one business day to confirm the time and video link.
          </p>
        </form>
        <script is:inline>
          (function () {
            var form = document.getElementById('demo-form');
            if (!form) return;
            form.addEventListener('submit', function (e) {
              e.preventDefault();
              if (!form.checkValidity()) { form.reportValidity(); return; }
              var success = document.getElementById('demo-success');
              if (success) success.removeAttribute('hidden');
              form.reset();
            });
          })();
        </script>
      </div>
    </div>
  </section>

</BaseLayout>
