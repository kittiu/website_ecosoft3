---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Why Ecosoft | Open Source ERP Partner — Thailand"
  description="10+ years, 40+ projects, 0 failed implementations. Learn why Thailand's leading organisations choose Ecosoft for open-source ERP."
>


  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Why Ecosoft</p>
        <h1>Building trust before the sales conversation begins.</h1>
        <p class="hero-lead">
          We believe the best way to earn your business is to be completely transparent about
          who we are, how we work, and what we stand for — before you ever speak with us.
          This section is that transparency.
        </p>
        <div class="hero-actions">
          <a href="/why-ecosoft/our-story" class="btn btn-primary">Our Story</a>
          <a href="/why-ecosoft/our-approach" class="btn btn-outline">How We Work</a>
        </div>
        <div class="hero-metas">
          <div>
            <p class="metric-number">2013</p>
            <p class="metric-label">founded</p>
          </div>
          <div>
            <p class="metric-number">40+</p>
            <p class="metric-label">projects delivered</p>
          </div>
          <div>
            <p class="metric-number">0</p>
            <p class="metric-label">failed projects</p>
          </div>
          <div>
            <p class="metric-number">120+</p>
            <p class="metric-label">open source modules</p>
          </div>
        </div>
      </div>
      <div class="hero-card">
        <div class="hero-card-main">
          <h2>What sets us apart</h2>
          <ul>
            <li>Thailand's only OCA-member ERP implementor</li>
            <li>Certified ERPNext partner &amp; active contributor</li>
            <li>Deep Thai accounting &amp; compliance expertise</li>
            <li>Full source code delivered at project close</li>
            <li>Lifetime partnership — not a one-off project</li>
          </ul>
        </div>
        <div class="hero-card-badges">
          <span>OCA Member</span>
          <span>ERPNext Certified</span>
          <span>Zero Lock-In</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION LINKS -->
  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Explore This Section</p>
        <h2>Everything you need to decide with confidence</h2>
      </header>
      <div class="cards-grid">
        <a href="/why-ecosoft/our-story" style="text-decoration: none;">
          <article class="info-card" style="height: 100%; cursor: pointer;">
            <div style="font-size: 1.6rem; margin-bottom: 0.5rem;">📖</div>
            <h3>Our Story</h3>
            <p>How Ecosoft was founded, what we believe, and where we are today.</p>
          </article>
        </a>
        <a href="/why-ecosoft/our-approach" style="text-decoration: none;">
          <article class="info-card" style="height: 100%; cursor: pointer;">
            <div style="font-size: 1.6rem; margin-bottom: 0.5rem;">🗺️</div>
            <h3>Our Approach</h3>
            <p>The 5-step methodology that has produced a 100% project success rate.</p>
          </article>
        </a>
        <a href="/why-ecosoft/why-open-source" style="text-decoration: none;">
          <article class="info-card" style="height: 100%; cursor: pointer;">
            <div style="font-size: 1.6rem; margin-bottom: 0.5rem;">🔓</div>
            <h3>Why Open Source</h3>
            <p>Addressing the biggest objections — and the genuine advantages — of open-source ERP.</p>
          </article>
        </a>
        <a href="/why-ecosoft/oca-membership" style="text-decoration: none;">
          <article class="info-card" style="height: 100%; cursor: pointer;">
            <div style="font-size: 1.6rem; margin-bottom: 0.5rem;">🏅</div>
            <h3>OCA Membership</h3>
            <p>Why being Thailand's only OCA member means higher quality code for your project.</p>
          </article>
        </a>
        <a href="/why-ecosoft/our-team" style="text-decoration: none;">
          <article class="info-card" style="height: 100%; cursor: pointer;">
            <div style="font-size: 1.6rem; margin-bottom: 0.5rem;">👥</div>
            <h3>Our Team</h3>
            <p>The practitioners who will implement your ERP — not a sales team, but domain experts.</p>
          </article>
        </a>
        <a href="/why-ecosoft/careers" style="text-decoration: none;">
          <article class="info-card" style="height: 100%; cursor: pointer;">
            <div style="font-size: 1.6rem; margin-bottom: 0.5rem;">🚀</div>
            <h3>Careers</h3>
            <p>Join the team building the future of open-source ERP in Thailand.</p>
          </article>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container cta-strip-grid">
      <div class="cta-strip-item">
        <h3>Seen enough to have a conversation?</h3>
        <p>Book a free consultation — no sales pitch, just an honest discussion about your ERP goals.</p>
        <a href="/contact" class="btn btn-white">Book a Free Consultation</a>
      </div>
      <div class="cta-strip-item">
        <h3>Want to see the software first?</h3>
        <p>Book a live demo tailored to your industry and business processes.</p>
        <a href="/book-demo" class="btn btn-teal-outline">Book a Demo →</a>
      </div>
    </div>
  </section>

</BaseLayout>
