---
import BaseLayout from "@layouts/BaseLayout.astro";

const openings = [
  {
    title: "ERP Business Analyst",
    team: "Consulting",
    count: 5,
    type: "Full-time",
    level: "Mid–Senior",
    week: "ทำงานกับลูกค้าเพื่อวางแผนกระบวนการทางธุรกิจ กำหนดค่า Odoo หรือ ERPNext นำ UAT sessions และส่งมอบการฝึกอบรมผู้ใช้งาน โครงการครอบคลุมภาคการผลิต การค้า และภาครัฐ",
    looking: [
      "ประสบการณ์ 3+ ปีในการให้คำปรึกษา ERP หรือบทบาท business analyst ที่เกี่ยวข้อง",
      "ความรู้ด้านบัญชี ห่วงโซ่อุปทาน หรือการดำเนินงานการจัดซื้อ",
      "ทักษะการสื่อสารที่เข้มแข็ง — คุณจะนำเสนอต่อผู้บริหารระดับ C",
      "ความสนใจใน Open Source software และความเต็มใจที่จะมีส่วนร่วม",
      "ต้องการความคล่องแคล่วภาษาไทย; ภาษาอังกฤษระดับธุรกิจเป็นที่ต้องการ",
    ],
    nice: "ประสบการณ์กับ Odoo หรือ ERPNext พื้นฐาน CPA หรือบัญชี ความรู้เรื่องการจัดซื้อภาครัฐ",
  },
  {
    title: "Software Developer — Odoo",
    team: "Engineering",
    count: 1,
    type: "Full-time",
    level: "Mid–Senior",
    week: "พัฒนา Odoo modules แบบกำหนดเองตามมาตรฐาน OCA ตรวจสอบและมีส่วนร่วมใน OCA repositories สนับสนุนการติดตั้งของลูกค้าด้วยโซลูชันทางเทคนิค และดูแลชุด Thai localisation ของเรา",
    looking: [
      "ประสบการณ์พัฒนา Python 2+ ปี",
      "ความเข้าใจสถาปัตยกรรม Odoo module (models, views, wizards, reports)",
      "ความมุ่งมั่นต่อมาตรฐานคุณภาพโค้ด OCA",
      "ความคุ้นเคยกับ Git และกระบวนการตรวจสอบโค้ด",
    ],
    nice: "การมีส่วนร่วม OCA ที่มีอยู่ ความรู้ด้านบัญชีไทยหรือกฎหมายภาษี ประสบการณ์กับ Odoo 16/17",
  },
  {
    title: "Software Developer — ERPNext",
    team: "Engineering",
    count: 1,
    type: "Full-time",
    level: "Mid–Senior",
    week: "สร้าง Frappe apps และ ERPNext extensions แบบกำหนดเอง มีส่วนร่วมกับ upstream ERPNext และ Frappe Framework และสนับสนุนการติดตั้ง ERPNext ที่ซับซ้อนในภาคการผลิตและเทคโนโลยี",
    looking: [
      "ประสบการณ์พัฒนา Python 2+ ปี",
      "ความคุ้นเคยกับ Frappe Framework และสถาปัตยกรรม ERPNext",
      "ประสบการณ์กับ JavaScript (Frappe UI components)",
      "สะดวกสบายในการมีส่วนร่วมใน public open-source repositories",
    ],
    nice: "การมีส่วนร่วม Frappe/ERPNext ที่มีอยู่บน GitHub ประสบการณ์กับกระบวนการทำงาน ERP สำหรับการผลิต ความรู้เรื่องเงินเดือนไทย",
  },
];
---

<BaseLayout
  title="ร่วมงานกับเรา | ทำไมต้อง Ecosoft"
  description="เข้าร่วมทีมที่กำลังสร้างอนาคตของ Open Source ERP ในประเทศไทย ตำแหน่งที่เปิดรับ: ERP Business Analyst (5), Software Developer — Odoo, Software Developer — ERPNext"
>


  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">ร่วมงานกับ Ecosoft</p>
        <h1>เข้าร่วมทีมที่กำลังสร้างอนาคตของ Open Source ERP ในประเทศไทย</h1>
        <p class="hero-lead">
          เรากำลังมองหาคนที่ใส่ใจเรื่องคุณภาพอย่างลึกซึ้ง ชอบแก้ปัญหาธุรกิจจริง
          และเชื่อในแนวทางของ Open Source Ecosoft มีสภาพแวดล้อมที่หาได้ยาก: เล็กพอที่จะ
          มีผลกระทบที่แท้จริงในทุกโครงการ ใหญ่พอที่จะสร้างประวัติ 10 ปีกับองค์กรที่น่าสนใจ
          ที่สุดของประเทศไทย
        </p>
        <div class="hero-metas">
          <div>
            <p class="metric-number">{openings.reduce((sum, j) => sum + j.count, 0)}</p>
            <p class="metric-label">ตำแหน่งที่เปิดรับ</p>
          </div>
          <div>
            <p class="metric-number">Bangkok</p>
            <p class="metric-label">สถานที่ทำงาน</p>
          </div>
          <div>
            <p class="metric-number">Hybrid</p>
            <p class="metric-label">รูปแบบการทำงาน</p>
          </div>
        </div>
      </div>
      <div class="hero-card">
        <div class="hero-card-main">
          <h2>ทำไมต้องเลือก Ecosoft</h2>
          <ul>
            <li>ทำงานกับปัญหาธุรกิจจริง — ไม่ใช่โครงการจำลอง</li>
            <li>มีส่วนร่วมใน Open Source repositories ระดับโลก</li>
            <li>เรียนรู้จากทีม ERP ที่มีประสบการณ์มากที่สุดในประเทศไทย</li>
            <li>ลูกค้าที่หลากหลาย: การผลิต ภาครัฐ เทคโนโลยีอวกาศ</li>
            <li>ทีมเล็ก ผลกระทบแท้จริงในทุกโครงการ</li>
          </ul>
        </div>
        <div class="hero-card-badges">
          <span>Open Source Culture</span>
          <span>Real-World ERP</span>
          <span>Bangkok Hybrid</span>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">วัฒนธรรมของเรา</p>
        <h2>สิ่งที่เราให้คุณค่า — และสิ่งที่เราไม่ให้</h2>
      </header>
      <div class="values-grid">
        <div class="value-card">
          <div class="value-card-icon">🎯</div>
          <h3>คุณภาพมาก่อนความเร็ว</h3>
          <p>เราสร้างสิ่งต่างๆ ให้ถูกต้อง ถ้า module ไม่ผ่านการตรวจสอบ OCA มันก็ไม่ถูกส่งออก เราอยากใช้เวลานานขึ้นและส่งมอบสิ่งที่ลูกค้าสามารถดูแลรักษาได้นาน 10 ปี</p>
        </div>
        <div class="value-card">
          <div class="value-card-icon">🔓</div>
          <h3>Open Source คือปรัชญา</h3>
          <p>เราไม่ใช่แค่ใช้ Open Source — เรามีส่วนร่วมสร้างมัน ถ้าคุณเข้าร่วม Ecosoft คุณจะได้รับการสนับสนุนให้มีส่วนร่วมอย่างเปิดเผยและสร้างชื่อเสียงในชุมชนระดับโลก</p>
        </div>
        <div class="value-card">
          <div class="value-card-icon">🤝</div>
          <h3>เข้าใจธุรกิจมาก่อน</h3>
          <p>เราจ้างที่ปรึกษาที่เข้าใจปัญหาทางธุรกิจที่พวกเขากำลังแก้ ทักษะทางเทคนิคสำคัญ แต่การตัดสินใจทางธุรกิจสำคัญกว่า</p>
        </div>
        <div class="value-card">
          <div class="value-card-icon">📈</div>
          <h3>คิดระยะยาว</h3>
          <p>เราสร้างความสัมพันธ์ที่ยาวนานหลายทศวรรษ สิ่งนี้ใช้ทั้งกับลูกค้าและทีมของเรา อัตราการลาออกต่ำเป็นสัญญาณว่าสิ่งต่างๆ ทำงานได้ดี</p>
        </div>
        <div class="value-card">
          <div class="value-card-icon">🌱</div>
          <h3>เรียนรู้อย่างต่อเนื่อง</h3>
          <p>แพลตฟอร์ม ERP พัฒนาอยู่ตลอดเวลา เราลงทุนในการพัฒนาทีมผ่านการเข้าร่วมการประชุม การมีส่วนร่วมในชุมชน และเวลาสำหรับการเรียนรู้</p>
        </div>
        <div class="value-card">
          <div class="value-card-icon">🚫</div>
          <h3>ไม่มีการเมือง ไม่มีการเสแสร้ง</h3>
          <p>ทีมเล็กทำงานได้ดีกว่าเมื่อทุกคนตรงไปตรงมาและซื่อสัตย์ เราไม่มีเวลาสำหรับการแสดงแบบองค์กร ผลลัพธ์และความประณีตในงานคือสิ่งที่สำคัญ</p>
        </div>
      </div>
    </div>
  </section>

  <!-- JOB LISTINGS -->
  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">ตำแหน่งที่เปิดรับ</p>
        <h2>ตำแหน่งปัจจุบัน</h2>
        <p>ทุกตำแหน่งตั้งอยู่ในกรุงเทพฯ พร้อมการทำงานแบบ Hybrid สมัครโดยส่ง CV และย่อหน้าสั้นๆ เกี่ยวกับเหตุผลที่คุณต้องการทำงานด้าน Open Source ERP มาทางอีเมล</p>
      </header>
      <div class="job-list">
        {openings.map((job) => (
          <article class="job-card">
            <div>
              <div class="job-card-meta">
                <span class="job-tag">{job.team}</span>
                <span class="job-tag">{job.level}</span>
                <span class="job-tag">{job.type}</span>
                {job.count > 1 && <span class="job-tag">{job.count} positions</span>}
              </div>
              <h3>{job.title}</h3>
              <p style="margin-bottom: 0.75rem;">{job.week}</p>
              <p style="font-size: 0.85rem; color: var(--text-faint); margin: 0;">
                <strong style="color: var(--text-subtle);">เรากำลังมองหา:</strong>{" "}
                {job.looking.slice(0, 2).join(" · ")}
              </p>
            </div>
            <div class="job-card-cta">
              <a href={`/contact?role=${encodeURIComponent(job.title)}`} class="btn btn-primary" style="font-size: 0.82rem; padding-inline: 1rem; padding-block: 0.55rem; white-space: nowrap;">
                สมัครเลย
              </a>
              <p style="font-size: 0.75rem; color: var(--text-faint); margin: 0; text-align: right;">careers@ecosoft.co.th</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- APPLY CTA -->
  <section class="cta-strip">
    <div class="container cta-strip-grid">
      <div class="cta-strip-item">
        <h3>ไม่เห็นตำแหน่งที่ตรงกับคุณหรือไม่?</h3>
        <p>เรารับสมัครคนที่มีความสามารถพิเศษเมื่อเจอ ส่ง CV ของคุณและบอกเราว่าคุณจะนำอะไรมาให้ Ecosoft</p>
        <a href="mailto:careers@ecosoft.co.th" class="btn btn-white">ส่งใบสมัครแบบ Speculative</a>
      </div>
      <div class="cta-strip-item">
        <h3>ต้องการทราบข้อมูลเพิ่มเติมก่อนสมัครหรือไม่?</h3>
        <p>อ่านเกี่ยวกับทีมที่คุณจะเข้าร่วมและงานที่เราทำ</p>
        <a href="/why-ecosoft/our-team" class="btn btn-teal-outline">พบกับทีม →</a>
      </div>
    </div>
  </section>

</BaseLayout>
