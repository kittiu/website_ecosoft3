---
import BaseLayout from "@layouts/BaseLayout.astro";

const team = [
  {
    icon: "👨‍💼",
    name: "Kitti Upariphutthangkul",
    role: "Founder & Lead Architect",
    bio: "ประสบการณ์กว่า 10 ปีในการสร้าง Open Source ERP ในประเทศไทย สมาชิก OCA ตั้งแต่ปี 2015 ความเชี่ยวชาญเชิงลึกด้านบัญชีไทย ห่วงโซ่อุปทาน และสถาปัตยกรรม Odoo ผู้มีส่วนร่วมอย่างแข็งขันใน OCA Thai localisation",
    tags: ["Odoo", "OCA", "Thai Accounting", "Architecture"],
  },
  {
    icon: "👩‍💻",
    name: "Senior ERP Consultant",
    role: "Business Analyst — ห่วงโซ่อุปทาน",
    bio: "ผู้เชี่ยวชาญในการติดตั้ง ERP สำหรับการผลิตและห่วงโซ่อุปทาน ประสบการณ์กว่า 7 ปีในการกำหนดค่ากระบวนการจัดซื้อ สินค้าคงคลัง และ MRP สำหรับบริษัทอุตสาหกรรมไทย",
    tags: ["Supply Chain", "Manufacturing", "ERPNext"],
  },
  {
    icon: "👨‍💻",
    name: "Senior Developer",
    role: "Software Engineer — Odoo",
    bio: "นักพัฒนา module มาตรฐาน OCA ที่มีความเชี่ยวชาญด้านการปรับแต่งบัญชีไทย ดูแล core modules ของ Ecosoft ใน OCA repository ระดับโลก",
    tags: ["Python", "Odoo", "OCA Modules"],
  },
  {
    icon: "👩‍💼",
    name: "ERP Business Analyst",
    role: "Consultant — การเงินและบัญชี",
    bio: "ผู้สอบบัญชีรับอนุญาต (CPA) ที่มีประสบการณ์ 8 ปีด้านบัญชีไทยและ ERP finance modules ผู้เชี่ยวชาญด้าน VAT ภาษีหัก ณ ที่จ่าย และข้อกำหนดการรายงานทางการเงินของภาครัฐ",
    tags: ["Finance", "Thai VAT", "Government ERP"],
  },
  {
    icon: "👨‍🔧",
    name: "ERPNext Developer",
    role: "Software Engineer — Frappe/ERPNext",
    bio: "ผู้มีส่วนร่วมอย่างแข็งขันในโครงการ Open Source ERPNext และ Frappe Framework ผู้เชี่ยวชาญด้านการติดตั้ง ERPNext สำหรับการผลิตและโครงการ",
    tags: ["Python", "ERPNext", "Frappe"],
  },
  {
    icon: "👩‍💻",
    name: "ERP Consultant",
    role: "Business Analyst — ภาครัฐ",
    bio: "ผู้เชี่ยวชาญด้าน ERP ภาคสาธารณะไทยที่มีประสบการณ์ที่ NSTDA, NXPO และ HII ความรู้เชิงลึกเกี่ยวกับระเบียบการจัดซื้อของรัฐบาลและการบัญชีกองทุน",
    tags: ["Government ERP", "Procurement", "Budget Control"],
  },
];
---

<BaseLayout
  title="ทีมของเรา | ทำไมต้อง Ecosoft"
  description="ผู้ปฏิบัติงานจริงที่จะติดตั้ง ERP ให้คุณ — ไม่ใช่ทีมขาย แต่เป็นผู้เชี่ยวชาญเฉพาะด้านบัญชีไทย ห่วงโซ่อุปทาน และแพลตฟอร์ม Open Source ERP"
>


  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div style="max-width: 44rem;">
        <p class="eyebrow">ทีมของเรา</p>
        <h1>คนที่จะติดตั้ง ERP ให้คุณ — ไม่ใช่ทีมขาย แต่เป็นผู้ปฏิบัติงานจริง</h1>
        <p class="hero-lead">
          ทีมของเราผสมผสานที่ปรึกษาเชิงหน้าที่ที่มีความรู้เชิงลึกด้านการจัดการห่วงโซ่อุปทาน
          บัญชีไทย และการจัดซื้อ — ควบคู่กับวิศวกรซอฟต์แวร์ที่มีส่วนร่วมอย่างแข็งขันในแพลตฟอร์ม
          Open Source ERP เมื่อคุณทำงานกับ Ecosoft คุณทำงานกับคนที่เข้าใจทั้งปัญหาทางธุรกิจ
          และโซลูชันทางเทคนิค
        </p>
      </div>
    </div>
  </section>

  <!-- TEAM GRID -->
  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">พบกับทีม</p>
        <h2>ผู้เชี่ยวชาญเฉพาะด้าน ไม่ใช่ผู้รู้ทั่วไป</h2>
        <p>สมาชิกทุกคนในทีมของเรามีประสบการณ์ปฏิบัติจริงในกระบวนการทางธุรกิจที่พวกเขาติดตั้ง เราจ้างผู้ปฏิบัติงาน ไม่ใช่พนักงานขาย</p>
      </header>
      <div class="team-grid">
        {team.map((member) => (
          <article class="team-card">
            <div class="team-card-avatar">{member.icon}</div>
            <div>
              <p class="team-card-name">{member.name}</p>
              <p class="team-card-role">{member.role}</p>
            </div>
            <p class="team-card-bio">{member.bio}</p>
            <div class="team-card-tags">
              {member.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY PRACTITIONERS MATTER -->
  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">ทำไมจึงสำคัญ</p>
        <h2>ความแตกต่างระหว่างผู้ปฏิบัติงานจริงและผู้รู้ทั่วไป</h2>
      </header>
      <div class="cards-grid">
        <article class="info-card pillar-card">
          <span class="pillar-number">01</span>
          <h3>พวกเขาเข้าใจจุดที่เป็นปัญหาของคุณ</h3>
          <p>นักบัญชีของเราเคยปิดสิ้นเดือนตามมาตรฐาน Thai GAAP ที่ปรึกษาห่วงโซ่อุปทานของเราเคยบริหารงานคลังสินค้า พวกเขารู้ว่าคุณหมายความว่าอะไรเมื่อคุณอธิบายปัญหา</p>
        </article>
        <article class="info-card pillar-card">
          <span class="pillar-number">02</span>
          <h3>พวกเขาออกแบบระบบที่ดีกว่า</h3>
          <p>ความรู้เฉพาะด้านสร้างการออกแบบ ERP ที่ดีกว่า ที่ปรึกษาที่เคยทำการกระทบยอดเจ้าหนี้รู้ว่าการกำหนดค่าใดช่วยประหยัดเวลา 10 ชั่วโมงต่อเดือนและอะไรสร้างคอขวด</p>
        </article>
        <article class="info-card pillar-card">
          <span class="pillar-number">03</span>
          <h3>พวกเขาฝึกอบรมได้ผลดีกว่า</h3>
          <p>วิทยากรที่เป็นผู้ปฏิบัติงานสอนด้วยภาษาของธุรกิจ — ไม่ใช่ภาษาของซอฟต์แวร์ ทีมของคุณเรียนรู้เร็วขึ้นและนำไปใช้งานได้มากขึ้น</p>
        </article>
        <article class="info-card pillar-card">
          <span class="pillar-number">04</span>
          <h3>พวกเขาอยู่กับคุณ</h3>
          <p>เรามีอัตราการลาออกต่ำ ที่ปรึกษาที่ค้นพบธุรกิจของคุณในขั้นตอนที่ 1 คือคนเดียวกับที่ดำเนินการฝึกอบรมเปิดตัวของคุณ ความต่อเนื่องนั้นมีความสำคัญ</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container cta-strip-grid">
      <div class="cta-strip-item">
        <h3>ต้องการร่วมทีมกับเราหรือไม่?</h3>
        <p>เรากำลังรับสมัครที่ปรึกษา ERP และนักพัฒนาที่ใส่ใจเรื่องคุณภาพและ Open Source</p>
        <a href="/why-ecosoft/careers" class="btn btn-white">ดูตำแหน่งงานที่เปิดรับ</a>
      </div>
      <div class="cta-strip-item">
        <h3>พร้อมทำงานกับเราหรือยัง?</h3>
        <p>เริ่มบทสนทนา — คุณจะพบกับทีมจริงๆ ไม่ใช่ตัวแทนฝ่ายขาย</p>
        <a href="/contact" class="btn btn-teal-outline">นัดหมายปรึกษาฟรี →</a>
      </div>
    </div>
  </section>

</BaseLayout>
